import React, { useEffect, useRef } from 'react';
import { ClipViewConfig } from '../types';
import { cubicHermite, computeHaarEnergy, computeAnalyticMagnitude } from '../utils/dsp';

interface WaveformProps {
  buffer: AudioBuffer;
  color: string;
  width: number;
  height: number;
  viewConfig: ClipViewConfig;
}

export const Waveform: React.FC<WaveformProps> = ({ buffer, color, width, height, viewConfig }) => {
  const canvasRef = useRef<HTMLCanvasElement>(null);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    // Safety Constraint
    const safeWidth = Math.max(1, Math.min(32000, Math.floor(width)));
    const safeHeight = Math.max(1, Math.floor(height));

    canvas.width = safeWidth;
    canvas.height = safeHeight;
    ctx.clearRect(0, 0, safeWidth, safeHeight);
    
    // Parse Color
    const hexToRgb = (hex: string) => {
        const bigint = parseInt(hex.replace('#', ''), 16);
        return { r: (bigint >> 16) & 255, g: (bigint >> 8) & 255, b: bigint & 255 };
    };
    const rgb = hexToRgb(color);
    const mid = safeHeight / 2;
    const scale = viewConfig?.scale || 1;
    const data = buffer.getChannelData(0);
    const mode = viewConfig.mode || 'PCM';

    // -------------------------------------------------------------------------
    // MODE: CANDLESTICK (Wavelet Analysis)
    // -------------------------------------------------------------------------
    if (mode === 'CANDLESTICK') {
        const candleWidth = Math.max(4, 8 * scale); // Width of each candle
        const gap = 1;
        const totalCandles = Math.ceil(safeWidth / (candleWidth + gap));
        const samplesPerCandle = Math.floor(data.length / totalCandles);

        // Gradient for Bullish (High Freq/Transient)
        const bullGrad = ctx.createLinearGradient(0, safeHeight, 0, 0);
        bullGrad.addColorStop(0, `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.2)`);
        bullGrad.addColorStop(1, `rgba(50, 255, 200, 0.9)`); // Cyan/Teal pop

        // Gradient for Bearish (Low Freq/Sustain)
        const bearGrad = ctx.createLinearGradient(0, safeHeight, 0, 0);
        bearGrad.addColorStop(0, `rgba(255, 50, 100, 0.9)`); // Pink/Red pop
        bearGrad.addColorStop(1, `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.2)`);

        for (let i = 0; i < totalCandles; i++) {
            const startIdx = i * samplesPerCandle;
            const endIdx = Math.min(data.length, startIdx + samplesPerCandle);
            if (startIdx >= data.length) break;

            // Extract Chunk
            const chunk = data.slice(startIdx, endIdx);
            
            // 1. RAW RANGE (Wicks) -> High/Low
            let min = 1.0; let max = -1.0;
            for (let j = 0; j < chunk.length; j++) {
                if (chunk[j] < min) min = chunk[j];
                if (chunk[j] > max) max = chunk[j];
            }
            // Enhance visual range for quiet signals
            const wickTop = mid - (max * (safeHeight/2) * scale);
            const wickBottom = mid - (min * (safeHeight/2) * scale);
            
            // 2. WAVELET ANALYSIS (Body) -> Open/Close approximation
            // Use Haar Wavelet Energy to determine the "Body" of the sound vs the transient peaks
            const { lowEnergy, highEnergy } = computeHaarEnergy(chunk);
            
            // Complex Analysis approximation (Analytic Magnitude)
            const analyticMag = computeAnalyticMagnitude(chunk);

            // Determine "Sentiment" (Color)
            // High Freq Dominance -> Bullish (Green/Cyan) -> Transients
            // Low Freq Dominance -> Bearish (Red/Pink) -> Bass/Sustain
            const spectralBalance = highEnergy / (lowEnergy + 0.001);
            const isBullish = spectralBalance > 0.5; // Arbitrary threshold for transient-heavy

            // Body Size is based on the Analytic Magnitude (Average Energy) vs Low Energy
            // This separates the "dense" part of the sound from the "peak" part.
            const bodyHalfHeight = (lowEnergy * (safeHeight/2) * scale);
            const bodyTop = mid - bodyHalfHeight;
            const bodyBottom = mid + bodyHalfHeight;

            const x = i * (candleWidth + gap);

            // Draw Wick (Range)
            ctx.beginPath();
            ctx.moveTo(x + candleWidth/2, wickTop);
            ctx.lineTo(x + candleWidth/2, wickBottom);
            ctx.strokeStyle = `rgba(${rgb.r},${rgb.g},${rgb.b}, 0.5)`;
            ctx.lineWidth = 1;
            ctx.stroke();

            // Draw Body (Energy)
            ctx.fillStyle = isBullish ? bullGrad : bearGrad;
            
            // Neon Glow effect for body
            ctx.shadowBlur = isBullish ? 10 : 5;
            ctx.shadowColor = isBullish ? '#0ff' : '#f0f';
            
            const bodyH = Math.max(2, bodyBottom - bodyTop);
            ctx.fillRect(x, bodyTop, candleWidth, bodyH);
            
            ctx.shadowBlur = 0;

            // Overlay: Complex Magnitude Marker (The "Price")
            // A horizontal line indicating the instantaneous analytic magnitude
            const priceY = mid - (analyticMag * (safeHeight/2) * scale * (data[startIdx] > 0 ? 1 : -1));
            ctx.fillStyle = '#fff';
            ctx.fillRect(x, priceY, candleWidth, 1);
        }
        return;
    }

    // -------------------------------------------------------------------------
    // MODE: PCM (Tensor Field Visualization)
    // -------------------------------------------------------------------------

    // 1. Field Background (Energy Density)
    const grad = ctx.createLinearGradient(0, 0, 0, safeHeight);
    grad.addColorStop(0, `rgba(${rgb.r},${rgb.g},${rgb.b},0)`);
    grad.addColorStop(0.5, `rgba(${rgb.r},${rgb.g},${rgb.b},0.15)`); // Subtle core glow
    grad.addColorStop(1, `rgba(${rgb.r},${rgb.g},${rgb.b},0)`);
    ctx.fillStyle = grad;
    ctx.fillRect(0,0,safeWidth, safeHeight);

    ctx.lineWidth = 1;
    const step = data.length / safeWidth;

    // 2. Vector Flux Lines (Discrete sampling of amplitude)
    ctx.beginPath();
    const vectorSpacing = Math.max(3, 6 / scale); 
    
    for (let x = 0; x < safeWidth; x += vectorSpacing) {
         const idx = Math.floor(x * step);
         if (idx >= data.length) break;
         
         // Peak detect in this slice
         let maxAbs = 0;
         const sliceWidth = Math.max(1, Math.floor(step));
         for (let j = 0; j < sliceWidth; j++) {
             if (idx + j >= data.length) break;
             const abs = Math.abs(data[idx + j]);
             if (abs > maxAbs) maxAbs = abs;
         }
         
         const h = maxAbs * (safeHeight / 2) * scale;
         if (h > 1) {
            ctx.moveTo(x, mid - h);
            ctx.lineTo(x, mid + h);
         }
    }
    ctx.strokeStyle = `rgba(${rgb.r},${rgb.g},${rgb.b},0.3)`;
    ctx.stroke();

    // 3. Main Envelope (The Tensor Boundary)
    ctx.beginPath();
    ctx.moveTo(0, mid);

    if (step >= 1) {
        // --- ZOOMED OUT: MIN/MAX DECIMATION ---
        const intStep = Math.ceil(step);
        for (let i = 0; i < safeWidth; i+=2) {
            let min = 1.0; let max = -1.0;
            const idx = Math.floor(i * step);
            for (let j = 0; j < intStep; j++) {
                if (idx + j >= data.length) break;
                const datum = data[idx + j];
                if (datum < min) min = datum;
                if (datum > max) max = datum;
            }
            const val = Math.abs(max) > Math.abs(min) ? max : min;
            const y = mid - (val * (safeHeight/2) * scale);
            ctx.lineTo(i, y);
        }
        for (let i = safeWidth; i >= 0; i-=2) {
            const idx = Math.floor(i * step);
            const y = mid + (data[Math.min(data.length-1, idx)] * (safeHeight/2) * scale * 0.1); 
            ctx.lineTo(i, y);
        }

    } else {
        // --- ZOOMED IN: CUBIC HERMITE INTERPOLATION ---
        for (let x = 0; x < safeWidth; x++) {
            const indexExact = x * step;
            const indexInt = Math.floor(indexExact);
            const t = indexExact - indexInt;

            const y0 = data[Math.max(0, indexInt - 1)];
            const y1 = data[indexInt];
            const y2 = data[Math.min(data.length - 1, indexInt + 1)];
            const y3 = data[Math.min(data.length - 1, indexInt + 2)];

            const val = cubicHermite(y0, y1, y2, y3, t);
            const y = mid - (val * (safeHeight/2) * scale);
            ctx.lineTo(x, y);
        }
    }
    
    // Stroke Styling
    ctx.globalCompositeOperation = 'source-over';
    ctx.shadowBlur = 8;
    ctx.shadowColor = color;
    ctx.strokeStyle = `rgba(${rgb.r},${rgb.g},${rgb.b},0.9)`;
    ctx.stroke();
    
    // 4. Highlight Overlay (White Hot Core)
    ctx.strokeStyle = 'rgba(255,255,255,0.6)';
    ctx.lineWidth = 0.5;
    ctx.shadowBlur = 0;
    ctx.stroke();

    // 5. Critical Points (Nodes)
    ctx.fillStyle = '#fff';
    ctx.beginPath();
    const nodeSpacing = Math.max(10, 50 / scale);
    for (let x = 0; x < safeWidth; x += nodeSpacing) {
        const idx = Math.floor(x * step);
        if (idx < data.length) {
            const val = data[idx];
            if (Math.abs(val) > 0.4) {
                 const y = mid - (val * (safeHeight/2) * scale);
                 ctx.moveTo(x + 1.5, y);
                 ctx.arc(x, y, 1.5, 0, Math.PI * 2);
            }
        }
    }
    ctx.fill();

  }, [buffer, color, width, height, viewConfig]);

  return <canvas ref={canvasRef} style={{ width: '100%', height: '100%' }} className="w-full h-full opacity-100 mix-blend-screen" />;
};
</file>

<file path="components/XYPad.tsx">
import React, { useRef, useState, useEffect } from 'react';

interface XYPadProps {
    x: number; // 0 to 1
    y: number; // 0 to 1
    onChange: (x: number, y: number) => void;
    labelX: string;
    labelY: string;
    color?: string;
}

// SDF Primitives
const sdCircle = (px: number, py: number, cx: number, cy: number, r: number) => {
    const dx = px - cx;
    const dy = py - cy;
    return Math.sqrt(dx*dx + dy*dy) - r;
};

export const XYPad: React.FC<XYPadProps> = ({ x, y, onChange, labelX, labelY, color = 'cyan' }) => {
    const padRef = useRef<HTMLDivElement>(null);
    const canvasRef = useRef<HTMLCanvasElement>(null);
    const [isDragging, setIsDragging] = useState(false);

    const colorMap: Record<string, string> = {
        cyan: '#00f0ff', blue: '#2f80ed', purple: '#b721ff', green: '#0aff60', 
        yellow: '#ffcc00', orange: '#ff6600', red: '#ff003c', pink: '#ff00d4'
    };
    const cHex = colorMap[color] || colorMap['cyan'];
    const hexToRgb = (hex: string) => {
        const bigint = parseInt(hex.replace('#', ''), 16);
        return { r: (bigint >> 16) & 255, g: (bigint >> 8) & 255, b: bigint & 255 };
    };
    const cRgb = hexToRgb(cHex);

    const updateFromPointer = (clientX: number, clientY: number) => {
        if (!padRef.current) return;
        const rect = padRef.current.getBoundingClientRect();
        let newX = (clientX - rect.left) / rect.width;
        let newY = 1 - ((clientY - rect.top) / rect.height);
        newX = Math.max(0, Math.min(1, newX));
        newY = Math.max(0, Math.min(1, newY));
        onChange(newX, newY);
    };

    useEffect(() => {
        if (isDragging) {
            const move = (e: MouseEvent) => { e.preventDefault(); updateFromPointer(e.clientX, e.clientY); };
            const up = () => setIsDragging(false);
            window.addEventListener('mousemove', move);
            window.addEventListener('mouseup', up);
            return () => { window.removeEventListener('mousemove', move); window.removeEventListener('mouseup', up); };
        }
    }, [isDragging]);

    // --- SDF Field Animation ---
    useEffect(() => {
        const canvas = canvasRef.current;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let frameId: number;
        let time = 0;

        const draw = () => {
            time += 0.02;
            const w = canvas.width = canvas.parentElement?.clientWidth || 200;
            const h = canvas.height = canvas.parentElement?.clientHeight || 200;

            ctx.clearRect(0, 0, w, h);
            
            // Map 0-1 coords to canvas
            const cx = x * w;
            const cy = (1 - y) * h;

            // Grid Resolution
            const res = 10;
            const cols = Math.ceil(w / res);
            const rows = Math.ceil(h / res);

            // SDF Rendering Loop
            for (let i = 0; i <= cols; i++) {
                for (let j = 0; j <= rows; j++) {
                    const px = i * res;
                    const py = j * res;

                    // Signed Distance to Puck
                    const dist = sdCircle(px, py, cx, cy, 0);
                    
                    // Add some noise field variation
                    const noise = Math.sin(px * 0.05 + time) * Math.cos(py * 0.05 + time) * 20;
                    
                    // Field intensity based on distance (Metaball-ish)
                    const field = Math.max(0, 150 - (dist + noise));
                    const normalizedField = Math.min(1, field / 100);

                    if (normalizedField > 0.1) {
                        // Vector Flow Direction
                        const angle = Math.atan2(cy - py, cx - px);
                        
                        // Draw Field Vector
                        const len = normalizedField * res * 1.5;
                        const ex = px + Math.cos(angle) * len;
                        const ey = py + Math.sin(angle) * len;

                        ctx.beginPath();
                        ctx.moveTo(px, py);
                        ctx.lineTo(ex, ey);
                        ctx.strokeStyle = `rgba(${cRgb.r},${cRgb.g},${cRgb.b},${normalizedField * 0.4})`;
                        ctx.lineWidth = 1;
                        ctx.stroke();
                        
                        // Draw Node if intense
                        if (normalizedField > 0.6) {
                            ctx.fillStyle = `rgba(${cRgb.r},${cRgb.g},${cRgb.b},${normalizedField})`;
                            ctx.fillRect(ex - 1, ey - 1, 2, 2);
                        }
                    }
                }
            }

            // Glow from center
            const gradient = ctx.createRadialGradient(cx, cy, 10, cx, cy, 100);
            gradient.addColorStop(0, `rgba(${cRgb.r},${cRgb.g},${cRgb.b},0.3)`);
            gradient.addColorStop(1, `rgba(${cRgb.r},${cRgb.g},${cRgb.b},0)`);
            ctx.fillStyle = gradient;
            ctx.fillRect(0,0,w,h);

            frameId = requestAnimationFrame(draw);
        };

        draw();
        return () => cancelAnimationFrame(frameId);
    }, [x, y, cRgb]);

    return (
        <div className="flex flex-col items-center w-full h-full p-2">
            <div 
                ref={padRef}
                className="w-full h-full border border-white/10 bg-black/60 rounded relative cursor-crosshair touch-none overflow-hidden group shadow-[inset_0_0_20px_rgba(0,0,0,1)]"
                onMouseDown={(e) => { setIsDragging(true); updateFromPointer(e.clientX, e.clientY); }}
                onTouchStart={(e) => { setIsDragging(true); updateFromPointer(e.touches[0].clientX, e.touches[0].clientY); }}
                onTouchMove={(e) => { if(isDragging) { e.preventDefault(); updateFromPointer(e.touches[0].clientX, e.touches[0].clientY); }}}
                onTouchEnd={() => setIsDragging(false)}
            >
                <canvas ref={canvasRef} className="absolute inset-0 w-full h-full pointer-events-none" />
                
                {/* Physical Puck */}
                <div 
                    className="absolute w-4 h-4 rounded-full border-2 border-white bg-black transform -translate-x-1/2 -translate-y-1/2 z-10 transition-transform duration-75"
                    style={{ 
                        left: `${x * 100}%`, 
                        bottom: `${y * 100}%`, 
                        borderColor: cHex,
                        boxShadow: `0 0 15px ${cHex}, inset 0 0 5px ${cHex}`
                    }}
                >
                    <div className="absolute inset-0 bg-white opacity-20 rounded-full animate-pulse"></div>
                </div>
                
                {/* Axis Labels */}
                <div className="absolute bottom-1 right-2 text-[7px] font-black text-slate-600 uppercase tracking-widest pointer-events-none" style={{ textShadow: `0 0 5px ${cHex}40` }}>{labelX} →</div>
                <div className="absolute top-1 left-2 text-[7px] font-black text-slate-600 uppercase tracking-widest pointer-events-none" style={{ textShadow: `0 0 5px ${cHex}40` }}>↑ {labelY}</div>
            </div>
        </div>
    );
};
</file>

<file path="hooks/useControlDrag.ts">
import { useState, useRef, useEffect, useCallback } from 'react';

interface UseControlDragProps {
    value: number;
    min: number;
    max: number;
    onChange: (val: number) => void;
    sensitivity?: number; // Pixels to traverse full range (default 200)
    direction?: 'vertical' | 'horizontal';
    logarithmic?: boolean;
}

export const useControlDrag = ({
    value, min, max, onChange,
    sensitivity = 200,
    direction = 'vertical',
    logarithmic = false
}: UseControlDragProps) => {
    const [isDragging, setIsDragging] = useState(false);
    const startPos = useRef(0);
    const startVal = useRef(0);

    // Normalize value 0..1
    const toNormal = useCallback((v: number) => {
        const safeV = Math.max(min, Math.min(max, v));
        if (logarithmic) {
            const minLog = Math.log(min === 0 ? 0.001 : min);
            const maxLog = Math.log(max);
            return (Math.log(safeV) - minLog) / (maxLog - minLog);
        }
        return (safeV - min) / (max - min);
    }, [min, max, logarithmic]);

    // Denormalize 0..1 to value
    const fromNormal = useCallback((n: number) => {
        const clamped = Math.max(0, Math.min(1, n));
        if (logarithmic) {
            const minLog = Math.log(min === 0 ? 0.001 : min);
            const maxLog = Math.log(max);
            return Math.exp(minLog + (maxLog - minLog) * clamped);
        }
        return min + clamped * (max - min);
    }, [min, max, logarithmic]);

    const [internalNormal, setInternalNormal] = useState(toNormal(value));

    // Sync external changes when not dragging
    useEffect(() => {
        if (!isDragging) {
            setInternalNormal(toNormal(value));
        }
    }, [value, toNormal, isDragging]);

    const handleStart = (clientPos: number) => {
        setIsDragging(true);
        startPos.current = clientPos;
        startVal.current = internalNormal;
        document.body.style.cursor = direction === 'vertical' ? 'ns-resize' : 'ew-resize';
        document.body.style.userSelect = 'none';
    };

    const handleMove = useCallback((clientPos: number, isFine: boolean) => {
        if (!isDragging) return;

        const deltaPixels = startPos.current - clientPos; // Up/Left drag increases value typically
        
        // Direction correction: Up (lower Y) is positive. Right (higher X) is positive.
        // If vertical: startY - currentY (positive delta = moving up)
        // If horizontal: currentX - startX (positive delta = moving right)
        const adjustedDelta = direction === 'vertical' ? deltaPixels : (clientPos - startPos.current);
        
        const effectiveSensitivity = isFine ? sensitivity * 5 : sensitivity;
        const deltaNormal = adjustedDelta / effectiveSensitivity;

        const newNormal = Math.max(0, Math.min(1, startVal.current + deltaNormal));
        
        setInternalNormal(newNormal);
        onChange(fromNormal(newNormal));
    }, [isDragging, sensitivity, direction, fromNormal, onChange]);

    const handleEnd = useCallback(() => {
        setIsDragging(false);
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
    }, []);

    useEffect(() => {
        if (isDragging) {
            const onMouseMove = (e: MouseEvent) => {
                e.preventDefault();
                const pos = direction === 'vertical' ? e.clientY : e.clientX;
                handleMove(pos, e.shiftKey || e.ctrlKey);
            };
            const onTouchMove = (e: TouchEvent) => {
                e.preventDefault(); 
                const pos = direction === 'vertical' ? e.touches[0].clientY : e.touches[0].clientX;
                handleMove(pos, false); // No modifier keys on touch usually
            };
            const onUp = () => handleEnd();

            window.addEventListener('mousemove', onMouseMove, { passive: false });
            window.addEventListener('touchmove', onTouchMove, { passive: false });
            window.addEventListener('mouseup', onUp);
            window.addEventListener('touchend', onUp);

            return () => {
                window.removeEventListener('mousemove', onMouseMove);
                window.removeEventListener('touchmove', onTouchMove);
                window.removeEventListener('mouseup', onUp);
                window.removeEventListener('touchend', onUp);
            };
        }
    }, [isDragging, handleMove, handleEnd, direction]);

    return {
        isDragging,
        handleStart,
        percentage: internalNormal
    };
};
</file>

