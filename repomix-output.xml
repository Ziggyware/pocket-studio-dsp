import { DSPState, Track, AudioClip, TrackFX, ClipFX } from '../types';
import { generateDriveCurve, generateBitcrushCurve, generateExpanderCurve, generateSoftClipCurve } from '../utils/dsp';

interface TrackChannel {
  input: GainNode;
  
  // Dynamics
  gate: WaveShaperNode; 
  compressor: DynamicsCompressorNode;

  // Tone
  hpf: BiquadFilterNode;
  eqLow: BiquadFilterNode;
  eqMid: BiquadFilterNode;
  eqHigh: BiquadFilterNode;

  // Color
  bitCrush: WaveShaperNode; 
  bitCrushMix: GainNode; 
  bitCrushDry: GainNode;
  drive: WaveShaperNode;
  distTone: BiquadFilterNode; 
  
  // AutoWah
  wahInput: GainNode;
  wahFollower: WaveShaperNode; // Rectifier
  wahSmooth: BiquadFilterNode; // LPF for Envelope
  wahFilter: BiquadFilterNode; // The effect filter
  wahGain: GainNode; // Sensitivity
  wahMix: GainNode;
  wahDry: GainNode;

  // Cab
  cabHpf: BiquadFilterNode;
  cabLpf: BiquadFilterNode;

  // Mod
  chorusDelay: DelayNode;
  chorusOsc: OscillatorNode;
  chorusGain: GainNode; 
  chorusMix: GainNode;
  chorusDry: GainNode;

  flangerDelay: DelayNode;
  flangerOsc: OscillatorNode;
  flangerGain: GainNode;
  flangerFeedback: GainNode;
  flangerMix: GainNode;
  flangerDry: GainNode;

  phaserSplit: GainNode;
  phaserFilters: BiquadFilterNode[];
  phaserOsc: OscillatorNode;
  phaserGain: GainNode;
  phaserMix: GainNode;
  phaserDry: GainNode;

  // Sends & Out
  reverbTone: BiquadFilterNode; 
  sendReverb: GainNode;
  sendDelay: GainNode;
  output: GainNode; 
  analyser: AnalyserNode; 
  panner: StereoPannerNode;
}

interface ActiveClipResource {
    source: AudioBufferSourceNode;
    drive: WaveShaperNode;
    filter: BiquadFilterNode;
    tremoloGain: GainNode;
    tremoloOsc: OscillatorNode;
    
    // New Clip FX
    ringModOsc: OscillatorNode;
    ringModGain: GainNode; // Mix
    
    delayNode: DelayNode;
    delayFeedback: GainNode;
    delayMix: GainNode;

    gain: GainNode;
    pan: StereoPannerNode;
}

export class AudioEngine {
  public ctx: AudioContext;
  public analyser: AnalyserNode; 
  public masterCompressor: DynamicsCompressorNode;
  
  private masterInput: GainNode; 
  private masterFilter: BiquadFilterNode;
  private masterEqLow: BiquadFilterNode;
  private masterEqMid: BiquadFilterNode;
  private masterEqHigh: BiquadFilterNode;
  private masterDrive: WaveShaperNode;
  
  private exciterSplit: GainNode;
  private exciterHpf: BiquadFilterNode;
  private exciterDrive: WaveShaperNode;
  private exciterGain: GainNode;
  private exciterMerge: GainNode;

  private msSplitter: ChannelSplitterNode;
  private msMerger: ChannelMergerNode;
  private midGain: GainNode;
  private sideGain: GainNode;
  
  private masterGain: GainNode;
  private masterSoftClip: WaveShaperNode; // New: Decomposes peaks before limiting
  private limiterNode: DynamicsCompressorNode;

  private reverbNode: ConvolverNode;
  private delayNode: DelayNode;
  private delayFeedback: GainNode;
  private returnReverbGain: GainNode;
  private returnDelayGain: GainNode;

  private trackChannels: Map<string, TrackChannel> = new Map();
  private activeClipResources: Map<string, ActiveClipResource> = new Map();
  
  private stream: MediaStream | null = null;
  private micSourceNode: MediaStreamAudioSourceNode | null = null;
  private mediaRecorder: MediaRecorder | null = null;
  private exportDest: MediaStreamAudioDestinationNode;

  constructor() {
    const AudioContextClass = (window.AudioContext || (window as any).webkitAudioContext);
    this.ctx = new AudioContextClass({ latencyHint: 'interactive' });
    
    this.masterInput = this.ctx.createGain();
    
    this.masterFilter = this.ctx.createBiquadFilter();
    this.masterEqLow = this.ctx.createBiquadFilter();
    this.masterEqMid = this.ctx.createBiquadFilter();
    this.masterEqHigh = this.ctx.createBiquadFilter();
    this.masterDrive = this.ctx.createWaveShaper();
    
    this.exciterSplit = this.ctx.createGain();
    this.exciterHpf = this.ctx.createBiquadFilter();
    this.exciterDrive = this.ctx.createWaveShaper();
    this.exciterGain = this.ctx.createGain();
    this.exciterMerge = this.ctx.createGain();

    this.masterCompressor = this.ctx.createDynamicsCompressor();
    
    this.msSplitter = this.ctx.createChannelSplitter(2);
    this.msMerger = this.ctx.createChannelMerger(2);
    this.midGain = this.ctx.createGain();
    this.sideGain = this.ctx.createGain();

    this.masterGain = this.ctx.createGain();
    this.masterSoftClip = this.ctx.createWaveShaper();
    this.limiterNode = this.ctx.createDynamicsCompressor();
    this.analyser = this.ctx.createAnalyser();
    
    this.exportDest = this.ctx.createMediaStreamDestination();

    this.masterFilter.type = 'lowpass'; 
    this.masterFilter.Q.value = 0;
    
    this.masterEqLow.type = 'lowshelf';
    this.masterEqLow.frequency.value = 200;
    
    this.masterEqMid.type = 'peaking';
    this.masterEqMid.frequency.value = 1000;
    
    this.masterEqHigh.type = 'highshelf';
    this.masterEqHigh.frequency.value = 4000;
    
    this.exciterHpf.type = 'highpass';
    this.exciterHpf.frequency.value = 3000;
    
    // USE UTILS
    this.exciterDrive.curve = generateDriveCurve(50);
    this.exciterDrive.oversample = '4x';
    
    this.masterDrive.curve = generateDriveCurve(0);
    this.masterDrive.oversample = '4x';
    
    // Hpe Master Soft Clip (Transparent peak absorption)
    this.masterSoftClip.curve = generateSoftClipCurve(1.2);
    this.masterSoftClip.oversample = '4x';

    // Brickwall Limiter Approximation
    this.limiterNode.threshold.value = -0.1;
    this.limiterNode.knee.value = 0;
    this.limiterNode.ratio.value = 20; // Hard limiting
    this.limiterNode.attack.value = 0.001; // 1ms (Fastest safe native)
    this.limiterNode.release.value = 0.1;

    this.masterInput.connect(this.masterFilter);
    this.masterFilter.connect(this.masterEqLow);
    this.masterEqLow.connect(this.masterEqMid);
    this.masterEqMid.connect(this.masterEqHigh);
    this.masterEqHigh.connect(this.masterDrive);
    
    this.masterDrive.connect(this.exciterSplit); 
    
    this.exciterSplit.connect(this.exciterHpf);
    this.exciterHpf.connect(this.exciterDrive);
    this.exciterDrive.connect(this.exciterGain);
    this.exciterGain.connect(this.exciterMerge);
    
    this.masterDrive.connect(this.exciterMerge);
    
    this.exciterMerge.connect(this.masterCompressor);

    this.masterCompressor.connect(this.msSplitter);
    this.msSplitter.connect(this.midGain, 0); 
    this.msSplitter.connect(this.sideGain, 1); 
    
    this.midGain.connect(this.msMerger, 0, 0);
    this.sideGain.connect(this.msMerger, 0, 1);
    
    this.msMerger.connect(this.masterGain);
    
    // Chain: Gain -> SoftClip -> HardLimiter -> Output
    this.masterGain.connect(this.masterSoftClip);
    this.masterSoftClip.connect(this.limiterNode);
    
    this.limiterNode.connect(this.analyser);
    this.analyser.connect(this.ctx.destination);
    this.limiterNode.connect(this.exportDest); 
    
    this.reverbNode = this.ctx.createConvolver();
    this.delayNode = this.ctx.createDelay(4.0);
    this.delayFeedback = this.ctx.createGain();
    this.returnReverbGain = this.ctx.createGain();
    this.returnDelayGain = this.ctx.createGain();

    this.reverbNode.connect(this.returnReverbGain);
    this.returnReverbGain.connect(this.masterInput);

    this.delayNode.connect(this.delayFeedback);
    this.delayFeedback.connect(this.delayNode); 
    this.delayNode.connect(this.returnDelayGain);
    this.returnDelayGain.connect(this.masterInput);

    this.generateImpulseResponse();
  }

  async resume() {
    if (this.ctx.state === 'suspended') {
      await this.ctx.resume();
    }
  }

  getTrackRMS(trackId: string): number {
      const ch = this.trackChannels.get(trackId);
      if (!ch) return 0;
      
      const data = new Uint8Array(ch.analyser.frequencyBinCount);
      ch.analyser.getByteTimeDomainData(data);
      
      let sum = 0;
      for(let i = 0; i < data.length; i += 4) {
          const amplitude = (data[i] - 128) / 128;
          sum += amplitude * amplitude;
      }
      return Math.sqrt(sum / (data.length / 4));
  }
  
  getMasterGainReduction(): number {
      if (this.masterCompressor && typeof this.masterCompressor.reduction === 'number') {
          return this.masterCompressor.reduction;
      } else if (this.masterCompressor && 'reduction' in this.masterCompressor) {
          return (this.masterCompressor.reduction as any).value || 0;
      }
      return 0;
  }

  private safeSet(param: AudioParam, value: number, time: number, ramp: number = 0.05) {
      if (typeof value === 'number' && Number.isFinite(value)) {
          param.setTargetAtTime(value, time, ramp);
      }
  }

  ensureTrackChannel(track: Track) {
    if (this.trackChannels.has(track.id)) return;

    // --- NODE CREATION ---
    const input = this.ctx.createGain();
    const gate = this.ctx.createWaveShaper(); 
    const compressor = this.ctx.createDynamicsCompressor();

    const hpf = this.ctx.createBiquadFilter();
    const eqLow = this.ctx.createBiquadFilter();
    const eqMid = this.ctx.createBiquadFilter();
    const eqHigh = this.ctx.createBiquadFilter();
    
    // AutoWah
    const wahInput = this.ctx.createGain();
    const wahFollower = this.ctx.createWaveShaper(); // Absolute value rectifier
    const wahSmooth = this.ctx.createBiquadFilter(); // Smoothing LPF
    const wahFilter = this.ctx.createBiquadFilter(); // The effect filter
    const wahGain = this.ctx.createGain(); // Sensitivity
    const wahMix = this.ctx.createGain();
    const wahDry = this.ctx.createGain();
    const wahSplit = this.ctx.createGain();
    const wahMerge = this.ctx.createGain();
    
    // Color
    const bitCrush = this.ctx.createWaveShaper();
    const bitCrushMix = this.ctx.createGain();
    const bitCrushDry = this.ctx.createGain();
    const bcSplit = this.ctx.createGain();
    const bcMerge = this.ctx.createGain();

    const drive = this.ctx.createWaveShaper();
    const distTone = this.ctx.createBiquadFilter();
    
    const cabHpf = this.ctx.createBiquadFilter();
    const cabLpf = this.ctx.createBiquadFilter();

    // Mod: Chorus
    const chorusSplit = this.ctx.createGain();
    const chorusDelay = this.ctx.createDelay(0.05);
    const chorusOsc = this.ctx.createOscillator();
    const chorusGain = this.ctx.createGain(); 
    const chorusMix = this.ctx.createGain();
    const chorusDry = this.ctx.createGain();
    const chorusMerge = this.ctx.createGain();

    // Mod: Flanger
    const flangerSplit = this.ctx.createGain();
    const flangerDelay = this.ctx.createDelay(0.02);
    const flangerOsc = this.ctx.createOscillator();
    const flangerGain = this.ctx.createGain();
    const flangerFeedback = this.ctx.createGain();
    const flangerMix = this.ctx.createGain();
    const flangerDry = this.ctx.createGain();
    const flangerMerge = this.ctx.createGain();

    // Mod: Phaser
    const phaserSplit = this.ctx.createGain();
    const phaserFilters = [
        this.ctx.createBiquadFilter(), this.ctx.createBiquadFilter(),
        this.ctx.createBiquadFilter(), this.ctx.createBiquadFilter()
    ];
    const phaserOsc = this.ctx.createOscillator();
    const phaserGain = this.ctx.createGain();
    const phaserMix = this.ctx.createGain();
    const phaserDry = this.ctx.createGain();
    const phaserMerge = this.ctx.createGain();

    const reverbTone = this.ctx.createBiquadFilter();
    const sendReverb = this.ctx.createGain();
    const sendDelay = this.ctx.createGain();
    const output = this.ctx.createGain();
    const analyser = this.ctx.createAnalyser(); 
    const panner = this.ctx.createStereoPanner();

    // --- CONFIG ---
    hpf.type = 'highpass';
    eqLow.type = 'lowshelf';
    eqMid.type = 'peaking';
    eqHigh.type = 'highshelf';
    distTone.type = 'lowpass';
    cabHpf.type = 'highpass';
    cabLpf.type = 'lowpass';
    reverbTone.type = 'highpass'; 
    analyser.fftSize = 256; 

    // AutoWah Config
    wahFollower.curve = new Float32Array([1, 0, 1]); // Simple Absolute Value Rectifier
    wahSmooth.type = 'lowpass';
    wahSmooth.frequency.value = 10; // Smoothing speed
    wahFilter.type = 'bandpass';
    
    // Chorus
    chorusOsc.type = 'sine';
    chorusOsc.start();
    chorusOsc.connect(chorusGain);
    chorusGain.connect(chorusDelay.delayTime);

    // Flanger
    flangerOsc.type = 'triangle';
    flangerOsc.start();
    flangerOsc.connect(flangerGain);
    flangerGain.connect(flangerDelay.delayTime);
    flangerDelay.connect(flangerFeedback);
    flangerFeedback.connect(flangerDelay);

    // Phaser (4-stage allpass)
    phaserOsc.type = 'sine';
    phaserOsc.start();
    phaserOsc.connect(phaserGain);
    phaserFilters.forEach(f => {
        f.type = 'allpass';
        phaserGain.connect(f.frequency);
    });

    drive.curve = generateDriveCurve(0);
    drive.oversample = '4x';
    bitCrush.curve = generateBitcrushCurve(16);
    gate.curve = generateExpanderCurve(-80); // Init with open gate

    // --- SIGNAL CHAIN WIRING ---
    input.connect(gate);
    gate.connect(compressor);
    compressor.connect(hpf);
    hpf.connect(eqLow);
    eqLow.connect(eqMid);
    eqMid.connect(eqHigh);
    
    // 1. AutoWah
    eqHigh.connect(wahSplit);
    wahSplit.connect(wahInput);
    
    wahInput.connect(wahFollower);
    wahFollower.connect(wahSmooth);
    wahSmooth.connect(wahGain);
    wahGain.connect(wahFilter.frequency); // Modulation!
    
    wahSplit.connect(wahFilter);
    wahFilter.connect(wahMix);
    wahSplit.connect(wahDry);
    
    wahMix.connect(wahMerge);
    wahDry.connect(wahMerge);

    // 2. Bitcrush
    wahMerge.connect(bcSplit);
    bcSplit.connect(bitCrush);
    bitCrush.connect(bitCrushMix);
    bitCrushMix.connect(bcMerge);
    bcSplit.connect(bitCrushDry);
    bitCrushDry.connect(bcMerge);

    // 3. Drive & Cab
    bcMerge.connect(drive);
    drive.connect(distTone);
    distTone.connect(cabHpf);
    cabHpf.connect(cabLpf);

    // 4. Modulations
    // Chain: Cab -> Chorus -> Flanger -> Phaser -> Sends
    
    // Chorus
    cabLpf.connect(chorusSplit);
    chorusSplit.connect(chorusDelay);
    chorusDelay.connect(chorusMix);
    chorusSplit.connect(chorusDry);
    chorusMix.connect(chorusMerge);
    chorusDry.connect(chorusMerge);

    // Flanger
    chorusMerge.connect(flangerSplit);
    flangerSplit.connect(flangerDelay);
    flangerDelay.connect(flangerMix);
    flangerSplit.connect(flangerDry);
    flangerMix.connect(flangerMerge);
    flangerDry.connect(flangerMerge);

    // Phaser
    flangerMerge.connect(phaserSplit);
    // Series Allpass Chain
    phaserSplit.connect(phaserFilters[0]);
    phaserFilters[0].connect(phaserFilters[1]);
    phaserFilters[1].connect(phaserFilters[2]);
    phaserFilters[2].connect(phaserFilters[3]);
    phaserFilters[3].connect(phaserMix);
    phaserSplit.connect(phaserDry);
    phaserMix.connect(phaserMerge);
    phaserDry.connect(phaserMerge);

    // Output
    phaserMerge.connect(output);
    output.connect(analyser); 
    analyser.connect(panner);

    // Sends (Pre-Fader / Post-FX)
    phaserMerge.connect(reverbTone);
    reverbTone.connect(sendReverb);
    sendReverb.connect(this.reverbNode);

    phaserMerge.connect(sendDelay);
    sendDelay.connect(this.delayNode);

    panner.connect(this.masterInput);

    this.trackChannels.set(track.id, {
        input, gate, compressor,
        hpf, eqLow, eqMid, eqHigh, 
        
        wahInput, wahFollower, wahSmooth, wahFilter, wahGain, wahMix, wahDry,
        
        bitCrush, bitCrushMix, bitCrushDry,
        drive, distTone, cabHpf, cabLpf,
        
        chorusDelay, chorusOsc, chorusGain, chorusMix, chorusDry,
        flangerDelay, flangerOsc, flangerGain, flangerFeedback, flangerMix, flangerDry,
        phaserSplit, phaserFilters, phaserOsc, phaserGain, phaserMix, phaserDry,
        
        reverbTone, sendReverb, sendDelay, 
        output, analyser, panner
    });

    this.updateTrackState(track);
  }

  updateTrackState(track: Track) {
    const ch = this.trackChannels.get(track.id);
    if (!ch) return;

    const t = this.ctx.currentTime;
    const ramp = 0.05;

    this.safeSet(ch.output.gain, track.muted ? 0 : track.volume, t, ramp);
    this.safeSet(ch.panner.pan, track.pan, t, ramp);

    // Dynamics (Updated for Hpe Noise Gate)
    ch.gate.curve = generateExpanderCurve(track.fx.gateThreshold);
    this.safeSet(ch.compressor.threshold, track.fx.compressorThreshold, t, ramp);
    this.safeSet(ch.compressor.ratio, track.fx.compressorRatio, t, ramp);
    this.safeSet(ch.compressor.attack, track.fx.compressorAttack || 0.003, t, ramp);
    this.safeSet(ch.compressor.release, track.fx.compressorRelease || 0.25, t, ramp);

    // EQ
    this.safeSet(ch.hpf.frequency, track.fx.highPassFreq, t, ramp);
    this.safeSet(ch.eqLow.gain, track.fx.eqLow, t, ramp);
    this.safeSet(ch.eqMid.gain, track.fx.eqMid, t, ramp);
    this.safeSet(ch.eqHigh.gain, track.fx.eqHigh, t, ramp);
    
    // AutoWah
    const wahMix = track.fx.autoWahMix || 0;
    this.safeSet(ch.wahMix.gain, wahMix, t, ramp);
    this.safeSet(ch.wahDry.gain, 1 - wahMix, t, ramp);
    this.safeSet(ch.wahGain.gain, (track.fx.autoWahSens || 0) * 50, t, ramp); // Scale sens
    this.safeSet(ch.wahFilter.Q, 6, t, ramp); 
    this.safeSet(ch.wahFilter.frequency, track.fx.autoWahFreq || 100, t, ramp); // Base

    // Color
    const totalSat = (track.fx.saturation || 0);
    ch.drive.curve = generateDriveCurve(totalSat);
    this.safeSet(ch.distTone.frequency, track.fx.distortionTone, t, ramp);
    ch.bitCrush.curve = generateBitcrushCurve(track.fx.bitCrushBits || 16);
    this.safeSet(ch.bitCrushMix.gain, track.fx.bitCrushMix || 0, t, ramp);
    this.safeSet(ch.bitCrushDry.gain, 1 - (track.fx.bitCrushMix || 0), t, ramp);

    // Chorus
    this.safeSet(ch.chorusMix.gain, track.fx.chorusMix || 0, t, ramp);
    this.safeSet(ch.chorusDry.gain, 1 - (track.fx.chorusMix || 0), t, ramp);
    this.safeSet(ch.chorusOsc.frequency, track.fx.chorusRate || 1.5, t, ramp);
    this.safeSet(ch.chorusGain.gain, track.fx.chorusDepth || 0.002, t, ramp);

    // Flanger
    const flangeMix = track.fx.flangerMix || 0;
    this.safeSet(ch.flangerMix.gain, flangeMix, t, ramp);
    this.safeSet(ch.flangerDry.gain, 1 - flangeMix, t, ramp);
    this.safeSet(ch.flangerOsc.frequency, track.fx.flangerRate || 0.5, t, ramp);
    this.safeSet(ch.flangerGain.gain, 0.002, t, ramp); // Fixed depth
    this.safeSet(ch.flangerFeedback.gain, track.fx.flangerFeedback || 0, t, ramp);

    // Phaser
    const phaseMix = track.fx.phaserMix || 0;
    this.safeSet(ch.phaserMix.gain, phaseMix, t, ramp);
    this.safeSet(ch.phaserDry.gain, 1 - phaseMix, t, ramp);
    this.safeSet(ch.phaserOsc.frequency, track.fx.phaserRate || 1.0, t, ramp);
    this.safeSet(ch.phaserGain.gain, 400, t, ramp); // Sweep depth
    ch.phaserFilters.forEach(f => {
        this.safeSet(f.Q, 1, t, ramp);
        this.safeSet(f.frequency, 800, t, ramp); // Base center
    });
    
    // Cab
    if (track.fx.cabinetOn) {
        this.safeSet(ch.cabHpf.frequency, 80, t, ramp);
        const lpfFreq = 2000 + (track.fx.cabinetTone * 6000); 
        this.safeSet(ch.cabLpf.frequency, lpfFreq, t, ramp);
    } else {
        this.safeSet(ch.cabHpf.frequency, 0, t, ramp);
        this.safeSet(ch.cabLpf.frequency, 22000, t, ramp);
    }

    // Sends
    this.safeSet(ch.sendReverb.gain, track.fx.sendReverb, t, ramp);
    const revToneFreq = 20 + (track.fx.reverbTone * 1000);
    this.safeSet(ch.reverbTone.frequency, revToneFreq, t, ramp);
    this.safeSet(ch.sendDelay.gain, track.fx.sendDelay, t, ramp);
  }

  updateMasterDSP(state: DSPState) {
      const t = this.ctx.currentTime;
      const ramp = 0.05;

      this.safeSet(this.masterGain.gain, state.masterVolume, t, ramp);
      
      if (state.masterFilterBypass) {
          this.safeSet(this.masterFilter.frequency, 22000, t, ramp);
          this.safeSet(this.masterFilter.Q, 0, t, ramp);
      } else {
          const safeFreq = Math.max(20, Math.min(22000, state.masterFilterFreq || 20000));
          this.safeSet(this.masterFilter.frequency, safeFreq, t, ramp);
          this.safeSet(this.masterFilter.Q, state.masterFilterRes || 0, t, ramp);
      }
      
      if (state.masterEqBypass) {
          this.safeSet(this.masterEqLow.gain, 0, t, ramp);
          this.safeSet(this.masterEqMid.gain, 0, t, ramp);
          this.safeSet(this.masterEqHigh.gain, 0, t, ramp);
      } else {
          this.safeSet(this.masterEqLow.gain, state.masterEqLow, t, ramp);
          this.safeSet(this.masterEqMid.gain, state.masterEqMid, t, ramp);
          this.safeSet(this.masterEqHigh.gain, state.masterEqHigh, t, ramp);
      }

      const sat = state.masterSaturationBypass ? 0 : (state.masterSaturation || 0);
      this.masterDrive.curve = generateDriveCurve(sat);

      const exciterDrive = state.masterExciterDrive !== undefined ? state.masterExciterDrive : 0;
      this.safeSet(this.exciterGain.gain, state.masterExciterBypass ? 0 : exciterDrive * 0.5, t, ramp); 

      if (state.masterCompressorBypass) {
          this.safeSet(this.masterCompressor.threshold, 0, t, ramp);
          this.safeSet(this.masterCompressor.ratio, 1, t, ramp);
      } else {
          this.safeSet(this.masterCompressor.threshold, state.masterCompressorThreshold, t, ramp);
          this.safeSet(this.masterCompressor.ratio, state.masterCompressorRatio, t, ramp);
      }

      if (state.masterStereoBypass) {
          this.safeSet(this.midGain.gain, 1, t, ramp);
          this.safeSet(this.sideGain.gain, 1, t, ramp);
      } else {
          const width = state.masterStereoWidth ?? 1;
          if (width <= 1) {
              this.safeSet(this.midGain.gain, 1, t, ramp);
              this.safeSet(this.sideGain.gain, width, t, ramp);
          } else {
              this.safeSet(this.midGain.gain, 2 - width, t, ramp);
              this.safeSet(this.sideGain.gain, 1 + (width-1)*0.5, t, ramp);
          }
      }

      if (state.masterSpatialBypass) {
          this.safeSet(this.returnDelayGain.gain, 0, t, ramp); 
          this.safeSet(this.returnReverbGain.gain, 0, t, ramp);
      } else {
          this.safeSet(this.delayNode.delayTime, state.delayTime, t, ramp);
          this.safeSet(this.delayFeedback.gain, state.delayFeedback, t, ramp);
          this.safeSet(this.returnDelayGain.gain, 0.7, t, ramp); 
          this.safeSet(this.returnReverbGain.gain, state.reverbMix, t, ramp);
      }
  }

  playClip(clip: AudioClip, projectTime: number) {
    const ch = this.trackChannels.get(clip.trackId);
    if (!ch) return; 

    const rate = clip.fx.pitch || 1.0;
    const clipStart = clip.startTime;
    const clipEnd = clip.startTime + (clip.duration / rate); 

    if (clipEnd <= projectTime) return;

    const source = this.ctx.createBufferSource();
    
    if (clip.fx.isReversed) {
        const original = clip.buffer;
        const reversed = this.ctx.createBuffer(original.numberOfChannels, original.length, original.sampleRate);
        for(let c=0; c<original.numberOfChannels; c++) {
            const dest = reversed.getChannelData(c);
            const src = original.getChannelData(c);
            for(let i=0; i<original.length; i++) dest[i] = src[original.length - 1 - i];
        }
        source.buffer = reversed;
    } else {
        source.buffer = clip.buffer;
    }

    source.playbackRate.value = rate;

    // --- Clip Chain ---
    const clipDrive = this.ctx.createWaveShaper();
    const clipFilter = this.ctx.createBiquadFilter();
    const clipGain = this.ctx.createGain();
    const clipPan = this.ctx.createStereoPanner();
    const tremoloGain = this.ctx.createGain();
    const tremoloOsc = this.ctx.createOscillator();
    const tremoloDepth = this.ctx.createGain();
    
    // Ring Mod
    const ringModGain = this.ctx.createGain();
    const ringModOsc = this.ctx.createOscillator();
    
    // Clip Delay
    const delayNode = this.ctx.createDelay(1.0);
    const delayFeedback = this.ctx.createGain();
    const delayMix = this.ctx.createGain();
    const delayDry = this.ctx.createGain();
    const delaySplit = this.ctx.createGain();
    const delayMerge = this.ctx.createGain();

    // FX CONFIG
    clipDrive.curve = generateDriveCurve(clip.fx.saturation || 0);
    
    clipFilter.type = 'lowpass';
    clipFilter.frequency.value = clip.fx.filterFreq ?? 20000;
    clipFilter.Q.value = clip.fx.filterRes ?? 0;

    clipGain.gain.value = clip.fx.gain;
    clipPan.pan.value = clip.fx.pan;

    // Tremolo
    tremoloOsc.frequency.value = clip.fx.tremoloRate || 4;
    tremoloOsc.start();
    tremoloDepth.gain.value = clip.fx.tremoloDepth || 0;
    tremoloOsc.connect(tremoloDepth);
    tremoloDepth.connect(tremoloGain.gain); 
    tremoloGain.gain.value = 1.0;

    // RingMod
    ringModOsc.type = 'sine';
    ringModOsc.frequency.value = clip.fx.ringModFreq || 440;
    ringModOsc.start();
    ringModGain.gain.value = 0; // modulated by osc
    ringModOsc.connect(ringModGain.gain);
    
    delayNode.delayTime.value = clip.fx.delayTime || 0.3;
    delayFeedback.gain.value = clip.fx.delayFeedback || 0.4;
    delayMix.gain.value = clip.fx.delayMix || 0;
    delayDry.gain.value = 1 - (clip.fx.delayMix || 0);

    // Chain Wiring
    source.connect(tremoloGain);
    tremoloGain.connect(clipDrive);
    clipDrive.connect(clipFilter);
    
    // Delay Wiring
    clipFilter.connect(delaySplit);
    delaySplit.connect(delayDry);
    delaySplit.connect(delayNode);
    delayNode.connect(delayFeedback);
    delayFeedback.connect(delayNode);
    delayNode.connect(delayMix);
    
    delayDry.connect(delayMerge);
    delayMix.connect(delayMerge);

    delayMerge.connect(clipGain);
    clipGain.connect(clipPan);
    clipPan.connect(ch.input);

    let startWhen = 0;
    let startOffset = 0;
    let duration = 0;

    if (clipStart >= projectTime) {
        startWhen = clipStart - projectTime;
        startOffset = clip.offset;
        duration = clip.duration;
    } else {
        const timeIntoClip = (projectTime - clipStart) * rate; 
        startWhen = 0;
        startOffset = clip.offset + timeIntoClip;
        duration = clip.duration - (timeIntoClip / rate);
    }
    
    if (duration > 0 && startOffset < source.buffer.duration) {
        source.start(this.ctx.currentTime + startWhen, startOffset, duration);
        
        const now = this.ctx.currentTime + startWhen;
        const fadeInDur = clip.fx.fadeIn || 0.005;
        clipGain.gain.setValueAtTime(0, now);
        clipGain.gain.linearRampToValueAtTime(clip.fx.gain, now + fadeInDur);
        
        const fadeOutDur = clip.fx.fadeOut || 0.005;
        const endTime = now + (duration / rate);
        clipGain.gain.setValueAtTime(clip.fx.gain, endTime - fadeOutDur);
        clipGain.gain.linearRampToValueAtTime(0, endTime);

        const resource: ActiveClipResource = {
            source, drive: clipDrive, filter: clipFilter,
            tremoloGain, tremoloOsc, 
            ringModOsc, ringModGain,
            delayNode, delayFeedback, delayMix,
            gain: clipGain, pan: clipPan
        };
        this.activeClipResources.set(clip.id, resource);
        
        source.onended = () => {
             this.activeClipResources.delete(clip.id);
        };
    }
  }

  updateClipParams(clipId: string, fx: Partial<ClipFX>) {
      const res = this.activeClipResources.get(clipId);
      if (!res) return; 

      const t = this.ctx.currentTime;
      const ramp = 0.05;

      if (typeof fx.gain === 'number') this.safeSet(res.gain.gain, fx.gain, t, ramp);
      if (typeof fx.pan === 'number') this.safeSet(res.pan.pan, Math.max(-1, Math.min(1, fx.pan)), t, ramp);
      if (typeof fx.pitch === 'number') this.safeSet(res.source.playbackRate, Math.max(0.1, fx.pitch), t, ramp);
      if (typeof fx.filterFreq === 'number') this.safeSet(res.filter.frequency, Math.max(10, Math.min(22000, fx.filterFreq)), t, ramp);
      if (typeof fx.filterRes === 'number') this.safeSet(res.filter.Q, fx.filterRes, t, ramp);
      if (typeof fx.saturation === 'number') res.drive.curve = generateDriveCurve(fx.saturation);
      
      if (typeof fx.delayTime === 'number') this.safeSet(res.delayNode.delayTime, fx.delayTime, t, ramp);
      if (typeof fx.delayFeedback === 'number') this.safeSet(res.delayFeedback.gain, fx.delayFeedback, t, ramp);
      if (typeof fx.delayMix === 'number') {
          this.safeSet(res.delayMix.gain, fx.delayMix, t, ramp);
          this.safeSet(res.gain.gain, 1 - fx.delayMix, t, ramp); 
      }
  }

  stopAll() {
    this.activeClipResources.forEach(r => { try { r.source.stop(); } catch(e){} });
    this.activeClipResources.clear();
  }

  async initMicrophone(): Promise<void> {
      if (this.stream) return;
      await this.resume();
      this.stream = await navigator.mediaDevices.getUserMedia({ 
          audio: { 
              echoCancellation: false, 
              autoGainControl: false, 
              noiseSuppression: false 
          } as any 
      });
  }

  connectInputToTrack(trackId: string) {
      if (!this.stream) return;
      const ch = this.trackChannels.get(trackId);
      if (!ch) return;
      
      // Disconnect previous if it exists
      if (this.micSourceNode) {
          this.micSourceNode.disconnect();
          this.micSourceNode = null;
      }
      
      this.micSourceNode = this.ctx.createMediaStreamSource(this.stream);
      this.micSourceNode.connect(ch.input);
  }

  disconnectInput() {
      if (this.micSourceNode) {
          this.micSourceNode.disconnect();
          this.micSourceNode = null;
      }
  }

  async startRecording(): Promise<void> {
    if (!this.stream) await this.initMicrophone();
    if (!this.stream) throw new Error("No Input Stream");

    try {
        this.mediaRecorder = new MediaRecorder(this.stream, { audioBitsPerSecond: 256000 });
    } catch (e) {
        this.mediaRecorder = new MediaRecorder(this.stream);
    }
    
    this.mediaRecorder.start();
  }

  async stopRecording(): Promise<Blob> {
    return new Promise((resolve, reject) => {
      if (!this.mediaRecorder || this.mediaRecorder.state === 'inactive') return reject('Recorder inactive');
      const chunks: BlobPart[] = [];
      this.mediaRecorder.ondataavailable = (e) => chunks.push(e.data);
      this.mediaRecorder.onstop = () => {
        const blob = new Blob(chunks, { type: 'audio/ogg; codecs=opus' });
        // Don't stop tracks here, or we lose monitoring
        resolve(blob);
      };
      this.mediaRecorder.stop();
    });
  }

  async decodeAudioData(blob: Blob): Promise<AudioBuffer> {
    const buf = await blob.arrayBuffer();
    return await this.ctx.decodeAudioData(buf);
  }
  
  startBounceRecorder(): void {
      const stream = this.exportDest.stream;
      const audioBitsPerSecond = 320000; 
      
      let options: any = { 
          mimeType: 'audio/webm;codecs=opus', 
          audioBitsPerSecond 
      };
      
      if (MediaRecorder.isTypeSupported('audio/mp4')) {
          options = { mimeType: 'audio/mp4', audioBitsPerSecond };
      } else if (!MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) {
          options = { audioBitsPerSecond };
      }
      
      try { 
          this.mediaRecorder = new MediaRecorder(stream, options); 
      } catch (e) { 
          this.mediaRecorder = new MediaRecorder(stream); 
      }
      this.mediaRecorder.start();
  }
  
  async stopBounceRecorder(): Promise<Blob> {
      return new Promise((resolve, reject) => {
          if (!this.mediaRecorder || this.mediaRecorder.state === 'inactive') return reject('No active export');
          const chunks: BlobPart[] = [];
          this.mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) chunks.push(e.data); };
          this.mediaRecorder.onstop = () => {
              const type = this.mediaRecorder?.mimeType || 'audio/mp4';
              const blob = new Blob(chunks, { type });
              resolve(blob);
          };
          this.mediaRecorder.stop();
      });
  }

  private generateImpulseResponse() {
    const rate = this.ctx.sampleRate;
    const length = rate * 1.5;
    const impulse = this.ctx.createBuffer(2, length, rate);
    const L = impulse.getChannelData(0);
    const R = impulse.getChannelData(1);
    for (let i = 0; i < length; i++) {
        const decay = Math.pow(1 - i / length, 4);
        L[i] = (Math.random() * 2 - 1) * decay;
        R[i] = (Math.random() * 2 - 1) * decay;
    }
    this.reverbNode.buffer = impulse;
  }
}

export const audioEngine = new AudioEngine();
