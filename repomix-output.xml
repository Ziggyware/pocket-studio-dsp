export interface TrackFX {
  // Dynamics
  gateThreshold: number; // -60 to 0 dB
  compressorThreshold: number; // dB
  compressorRatio: number; // Ratio
  compressorAttack: number; // ms
  compressorRelease: number; // ms

  // EQ
  highPassFreq: number; // Hz
  eqLow: number; // dB
  eqMid: number; // dB
  eqHigh: number; // dB
  presence: number; // Hz
  
  // Color
  saturation: number; // 0-100
  distortionTone: number; // Hz
  bitCrushBits: number; // 1-16
  bitCrushMix: number; // 0-1
  autoWahMix: number; // 0-1
  autoWahSens: number; // Sensitivity 0-100
  autoWahFreq: number; // Base frequency

  // Cabinet
  cabinetOn: boolean;
  cabinetTone: number; // 0-1

  // Modulation
  chorusMix: number; // 0-1
  chorusRate: number; // Hz
  chorusDepth: number; // ms

  flangerMix: number; // 0-1
  flangerRate: number; // Hz
  flangerFeedback: number; // 0-0.95

  phaserMix: number; // 0-1
  phaserRate: number; // Hz

  // Sends
  sendReverb: number; // 0-1
  reverbTone: number; // 0-1
  sendDelay: number; // 0-1
}

export interface ClipFX {
  gain: number; 
  pitch: number; 
  pan: number; 
  isReversed: boolean;
  
  // Envelopes
  fadeIn: number; 
  fadeOut: number; 

  // Modulation
  tremoloDepth: number; 
  tremoloRate: number; 

  // Ring Mod
  ringModFreq: number;
  ringModMix: number;

  // Clip Delay
  delayTime: number; // 0 - 1s
  delayFeedback: number; // 0 - 0.9
  delayMix: number; // 0 - 1

  // DSP
  filterFreq: number; 
  filterRes: number; 
  saturation: number; 
}

export type WaveformMode = 'PCM' | 'CANDLESTICK';

export interface ClipViewConfig {
    mode: WaveformMode;
    resolution: number; // 1 to 5
    scale: number; // 0.5 to 3.0
}

export interface Track {
  id: string;
  name: string;
  color: string;
  muted: boolean;
  solo: boolean;
  armed: boolean;
  volume: number;
  pan: number;
  fx: TrackFX; 
  isExpanded: boolean; 
}

export interface AudioClip {
  id: string;
  trackId: string;
  buffer: AudioBuffer;
  startTime: number;
  duration: number;
  offset: number;
  name: string;
  fx: ClipFX;
  viewConfig: ClipViewConfig; 
}

export interface ProjectMetadata {
  title: string;
  artist: string;
  album: string;
  year: string;
}

export enum EditMode {
  MOVE = 'MOVE',
  SPLIT = 'SPLIT',
  DELETE = 'DELETE'
}

export interface ViewSettings {
