<file path="components/ChannelStrip.tsx">
import React, { useState, useRef, useEffect } from 'react';
import { Track, ViewSettings } from '../types';
import { COLORS, TRACK_HEIGHT, EXPANDED_TRACK_HEIGHT, TRACK_PRESETS } from '../constants';
import { Knob } from './Knob';
import { Fader } from './Fader';
import { Toggle } from './Toggle';
import { XYPad } from './XYPad';
import { audioEngine } from '../services/audioEngine';
import { DynamicsTransfer, FilterResponse, LFOOscilloscope } from './Visualizers';

interface ChannelStripProps {
  track: Track;
  onUpdate: (id: string, updates: Partial<Track>) => void;
  onToggleArm: (id: string) => void;
  onToggleExpand: (id: string) => void;
  onDuplicate: (id: string) => void;
  onDelete: (id: string) => void;
  width: number;
  viewSettings: ViewSettings;
  isCollapsed: boolean;
}

type Tab = 'DYNAMICS' | 'EQUALIZER' | 'MODULATION' | 'SPACE';

export const ChannelStrip: React.FC<ChannelStripProps> = React.memo(({ 
    track, onUpdate, onToggleArm, onToggleExpand, onDuplicate, onDelete,
    width, viewSettings, isCollapsed 
}) => {
  const [showColors, setShowColors] = useState(false);
  const [showPresets, setShowPresets] = useState(false);
  const [activeTab, setActiveTab] = useState<Tab>('DYNAMICS');
  const menuRef = useRef<HTMLDivElement>(null);
  const presetRef = useRef<HTMLDivElement>(null);
  const meterCanvasRef = useRef<HTMLCanvasElement>(null);

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (menuRef.current && !menuRef.current.contains(event.target as Node)) setShowColors(false);
      if (presetRef.current && !presetRef.current.contains(event.target as Node)) setShowPresets(false);
    };
    if (showColors || showPresets) document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, [showColors, showPresets]);

  // Meter Animation Loop
  useEffect(() => {
    if (isCollapsed) return;
    const canvas = meterCanvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let animId: number;
    let peakHold = 0;
    let peakTimer = 0;

    const drawMeter = () => {
        const rms = audioEngine.getTrackRMS(track.id);
        const w = canvas.width;
        const h = canvas.height;
        ctx.clearRect(0, 0, w, h);
        
        ctx.fillStyle = '#111';
        ctx.fillRect(0, 0, w, h);
        
        const level = Math.min(1.0, rms * 2.5); 
        const activeW = level * w;
        
        const grad = ctx.createLinearGradient(0, 0, w, 0);
        grad.addColorStop(0, track.color + '20'); 
        grad.addColorStop(0.5, track.color);     
        grad.addColorStop(1, '#fff');            
        
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, activeW, h);

        if (level > peakHold) {
            peakHold = level;
            peakTimer = 60;
        } else {
            if (peakTimer > 0) peakTimer--;
            else peakHold *= 0.95;
        }

        ctx.fillStyle = '#fff';
        ctx.fillRect(peakHold * w, 0, 2, h);
        ctx.fillStyle = 'rgba(0,0,0,0.5)';
        for(let i=1; i<10; i++) ctx.fillRect(i * (w/10), 0, 1, h);

        animId = requestAnimationFrame(drawMeter);
    };

    drawMeter();
    return () => cancelAnimationFrame(animId);
  }, [track.id, track.color, isCollapsed]);

  const updateFX = (key: keyof typeof track.fx, value: any) => {
      onUpdate(track.id, {
          fx: { ...track.fx, [key]: value }
      });
  };
  
  const applyPreset = (presetName: string) => {
      const preset = TRACK_PRESETS[presetName];
      if (preset) {
          onUpdate(track.id, {
              fx: { ...track.fx, ...preset }
          });
          setShowPresets(false);
      }
  };

  const isWide = width > 200;

  return (
    <div 
        className="sticky left-0 z-20 flex flex-col transition-all duration-300 ease-out group shadow-[4px_0_20px_rgba(0,0,0,0.8)] overflow-hidden" 
        style={{ 
            width: width,
            height: track.isExpanded ? EXPANDED_TRACK_HEIGHT : TRACK_HEIGHT,
            background: '#0a0a0c',
            borderRight: `1px solid ${track.color}20`
        }}
    >
       {/* --- HEADER SECTION --- */}
       <div className="p-3 flex-shrink-0 flex flex-col relative" style={{ height: TRACK_HEIGHT }}>
            <div className={`flex items-center gap-2 relative z-30 transition-all ${isCollapsed ? 'justify-center flex-col h-full space-y-4' : 'justify-between mb-2'}`}>
                <div className="relative flex-shrink-0" ref={menuRef}>
                    <button
                        className="w-3 h-3 rounded-full transition-all duration-300 hover:scale-125"
                        style={{ backgroundColor: track.color, boxShadow: `0 0 8px ${track.color}` }}
                        onClick={() => setShowColors(!showColors)}
                    />
                    {showColors && (
                    <div className="absolute top-full left-0 mt-2 bg-black/90 backdrop-blur-xl border border-white/10 p-2 rounded-lg grid grid-cols-4 gap-2 shadow-2xl z-50 w-32 animate-in zoom-in-95 duration-100">
                        {COLORS.map(c => (
                            <button key={c} className="w-5 h-5 rounded-full border border-white/10 hover:scale-110 transition-transform" style={{ backgroundColor: c, boxShadow: `0 0 10px ${c}` }}
                            onClick={(e) => { e.stopPropagation(); onUpdate(track.id, { color: c }); setShowColors(false); }} />
                        ))}
                    </div>
                    )}
                </div>
                {!isCollapsed && (
                    <input
                        className="bg-transparent text-[13px] font-bold text-slate-200 w-full outline-none px-0.5 truncate tracking-wide focus:text-white placeholder-slate-600 font-mono transition-all"
                        value={track.name}
                        onChange={(e) => onUpdate(track.id, { name: e.target.value })}
                        style={{ opacity: width < 60 ? 0 : 1 }}
                    />
                )}
                <button 
                    onClick={() => onToggleArm(track.id)} 
                    className={`w-6 h-6 rounded-full flex-shrink-0 flex items-center justify-center transition-all ${track.armed ? 'bg-red-500/10 shadow-[0_0_15px_rgba(220,38,38,0.4)]' : 'bg-transparent hover:bg-white/5'}`}
                >
                    <div className={`w-2.5 h-2.5 rounded-full transition-all ${track.armed ? 'bg-red-500 animate-pulse' : 'bg-slate-700'}`} />
                </button>
            </div>

            {!isCollapsed && (
                <div className={`flex space-x-1 mb-3 transition-all duration-300 overflow-hidden ${viewSettings.showTransport ? 'opacity-100 max-h-10' : 'opacity-0 max-h-0'}`}>
                    <Toggle value={track.muted} onChange={() => onUpdate(track.id, { muted: !track.muted })} label="MUTE" color="orange" size="sm" />
                    <Toggle value={track.solo} onChange={() => onUpdate(track.id, { solo: !track.solo })} label="SOLO" color="yellow" size="sm" />
                    {viewSettings.showRack && (
                        <Toggle value={track.isExpanded} onChange={() => onToggleExpand(track.id)} label="FX" color="blue" size="sm" />
                    )}
                </div>
            )}
            
            {!isCollapsed && width > 100 && (
                <div className="absolute right-2 top-10 flex flex-col gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                    <button 
                        className="text-[8px] text-slate-700 hover:text-white uppercase tracking-wider"
                        onClick={() => onDuplicate(track.id)}
                    >Dup</button>
                    <button 
                        className="text-[8px] text-red-700 hover:text-red-500 uppercase tracking-wider"
                        onClick={() => onDelete(track.id)}
                    >Del</button>
                </div>
             )}

            {!isCollapsed && (
                <div className={`flex flex-col space-y-3 transition-all duration-500 overflow-hidden ${viewSettings.showMix ? 'opacity-100 max-h-24' : 'opacity-0 max-h-0'}`}>
                    {/* Volume Meter & Fader Logic (Simplified for Strip view) */}
                    <div className="flex items-center space-x-2 group/vol relative">
                         {isWide && <span className="text-[8px] font-bold text-slate-600 w-8 text-right">VOL</span>}
                        <div className="flex-1 h-3 relative flex items-center bg-[#111] rounded-sm overflow-hidden border border-white/10 cursor-ew-resize">
                            <canvas ref={meterCanvasRef} width={200} height={12} className="absolute inset-0 w-full h-full opacity-60 pointer-events-none" />
                            <div className="absolute top-0 bottom-0 w-1 bg-white shadow-[0_0_10px_white] z-10 pointer-events-none" style={{ left: `${track.volume * 100}%` }}></div>
                            <input 
                                type="range" min="0" max="1" step="0.01" value={track.volume} 
                                onChange={(e) => onUpdate(track.id, { volume: parseFloat(e.target.value) })}
                                className="absolute w-full h-full opacity-0 cursor-ew-resize z-20" 
                            />
                        </div>
                        {isWide && <span className="text-[9px] font-mono text-white w-8 text-right">{(track.volume * 100).toFixed(0)}</span>}
                    </div>

                    {/* Pan Logic */}
                    <div className="flex items-center space-x-2 group/pan">
                         {isWide && <span className="text-[8px] font-bold text-slate-600 w-8 text-right">PAN</span>}
                        <div className="flex-1 h-1.5 relative flex items-center bg-[#111] rounded-full border border-white/5 cursor-ew-resize">
                            <div className="absolute left-1/2 w-px h-full bg-slate-600"></div>
                            <div className="absolute h-2.5 w-2.5 rounded-full shadow-[0_0_8px_white] bg-white pointer-events-none transition-transform top-1/2 -translate-y-1/2" style={{ left: `calc(${((track.pan + 1) / 2) * 100}% - 5px)` }} />
                            <input 
                                type="range" min="-1" max="1" step="0.1" value={track.pan} 
                                onChange={(e) => onUpdate(track.id, { pan: parseFloat(e.target.value) })}
                                className="absolute w-full h-full opacity-0 cursor-ew-resize" 
                            />
                        </div>
                        {isWide && <span className="text-[9px] font-mono text-slate-400 w-8 text-right">{track.pan.toFixed(1)}</span>}
                    </div>
                </div>
            )}
       </div>

       {/* --- MODULAR FX RACK --- */}
       {track.isExpanded && !isCollapsed && (
           <div className="flex-1 flex flex-col overflow-hidden relative bg-[#050505] animate-in slide-in-from-left duration-300">
               
               {/* PRESET MENU */}
               <div className="absolute top-0 right-0 z-50 p-2" ref={presetRef}>
                  <button 
                      onClick={() => setShowPresets(!showPresets)}
                      className="px-2 py-1 bg-[#1a1a1e] border border-white/10 rounded text-[9px] font-bold text-cyan-500 hover:text-cyan-400 hover:border-cyan-500/50 uppercase tracking-widest"
                  >
                      Presets
                  </button>
                  {showPresets && (
                      <div className="absolute right-2 top-8 w-48 bg-black/95 border border-cyan-900 rounded shadow-2xl overflow-hidden flex flex-col max-h-64 overflow-y-auto z-50">
                          {Object.keys(TRACK_PRESETS).map(name => (
                              <button
                                  key={name}
                                  onClick={() => applyPreset(name)}
                                  className="text-left px-3 py-2 text-[10px] text-slate-300 hover:bg-cyan-900/30 hover:text-white border-b border-white/5 last:border-0 font-mono"
                              >
                                  {name}
                              </button>
                          ))}
                      </div>
                  )}
               </div>

               {/* TABS */}
               <div className="flex border-b border-white/5 bg-[#080808]">
                   {(['DYNAMICS', 'EQUALIZER', 'MODULATION', 'SPACE'] as Tab[]).map(tab => (
                       <button
                           key={tab}
                           onClick={() => setActiveTab(tab)}
                           className={`flex-1 py-3 text-[9px] font-black tracking-widest border-r border-white/5 transition-colors
                           ${activeTab === tab ? 'bg-[#111] text-cyan-400 border-b-2 border-b-cyan-500' : 'text-slate-600 hover:text-slate-400'}`}
                       >{tab}</button>
                   ))}
               </div>

               {/* TAB CONTENT (GRID LAYOUT) */}
               <div className="flex-1 overflow-y-auto p-0 scrollbar-hide bg-[#0b0b0d]">
                   
                   {/* 1. DYNAMICS: GATE + COMPRESSOR */}
                   {activeTab === 'DYNAMICS' && (
                       <div className="h-full flex flex-col">
                           {/* TOP: COMPRESSOR VISUALIZER + MAIN CONTROLS */}
                           <div className="h-[200px] relative border-b border-white/5 p-4 flex items-center justify-around overflow-hidden">
                               <DynamicsTransfer threshold={track.fx.compressorThreshold} ratio={track.fx.compressorRatio} color="#eab308" />
                               <div className="relative z-10 flex space-x-6">
                                    <Knob value={track.fx.compressorThreshold} min={-60} max={0} label="THRESH" unit="dB" color="yellow" size={50} onChange={(v) => updateFX('compressorThreshold', v)} />
                                    <Knob value={track.fx.compressorRatio} min={1} max={20} label="RATIO" unit=":1" color="yellow" size={50} onChange={(v) => updateFX('compressorRatio', v)} />
                               </div>
                           </div>
                           {/* BOTTOM: ENVELOPE + GATE */}
                           <div className="flex-1 grid grid-cols-2">
                               <div className="border-r border-white/5 p-2 flex flex-col items-center justify-center space-y-2 bg-[#0e0e11]">
                                   <span className="text-[8px] font-bold text-slate-500 mb-1">ENVELOPE</span>
                                   <div className="flex space-x-2">
                                       <Knob value={(track.fx.compressorAttack || 0.003) * 1000} min={1} max={100} label="ATTACK" unit="ms" color="yellow" size={36} onChange={(v) => updateFX('compressorAttack', v/1000)} />
                                       <Knob value={(track.fx.compressorRelease || 0.25) * 1000} min={10} max={1000} label="RELEASE" unit="ms" color="yellow" size={36} onChange={(v) => updateFX('compressorRelease', v/1000)} />
                                   </div>
                               </div>
                               <div className="p-2 flex flex-col items-center justify-center space-y-2 bg-[#0e0e11]">
                                   <span className="text-[8px] font-bold text-green-500 mb-1">NOISE GATE</span>
                                   <Knob value={track.fx.gateThreshold} min={-80} max={0} label="FLOOR" unit="dB" color="green" size={40} onChange={(v) => updateFX('gateThreshold', v)} />
                               </div>
                           </div>
                       </div>
                   )}

                   {/* 2. EQUALIZER */}
                   {activeTab === 'EQUALIZER' && (
                       <div className="h-full flex flex-col relative">
                            {/* EQ VISUALIZER BACKGROUND */}
                            <div className="absolute inset-0 opacity-20 pointer-events-none">
                                <FilterResponse freq={track.fx.highPassFreq} res={0.7} type="highpass" color="#555" />
                                <FilterResponse freq={200} res={0.7} gain={track.fx.eqLow} type="lowshelf" color="#06b6d4" />
                                <FilterResponse freq={1000} res={0.7} gain={track.fx.eqMid} type="peaking" color="#06b6d4" />
                                <FilterResponse freq={4000} res={0.7} gain={track.fx.eqHigh} type="highshelf" color="#06b6d4" />
                            </div>

                            <div className="flex-1 grid grid-cols-3 gap-px bg-white/5">
                                <div className="bg-[#0b0b0d] flex flex-col items-center justify-center pt-4">
                                    <Fader value={track.fx.eqLow} min={-12} max={12} label="LOW" unit="dB" color="cyan" height={160} onChange={(v) => updateFX('eqLow', v)} />
                                    <div className="mt-2 border-t border-white/5 w-full flex justify-center py-2">
                                       <Knob value={track.fx.highPassFreq} min={20} max={500} logarithmic label="HPF" unit="Hz" color="slate" size={32} onChange={(v) => updateFX('highPassFreq', v)} />
                                    </div>
                                </div>
                                <div className="bg-[#0b0b0d] flex flex-col items-center justify-center pt-4">
                                    <Fader value={track.fx.eqMid} min={-12} max={12} label="MID" unit="dB" color="cyan" height={160} onChange={(v) => updateFX('eqMid', v)} />
                                    <div className="mt-2 border-t border-white/5 w-full flex justify-center py-2">
                                       <span className="text-[9px] text-slate-700 font-mono">1kHz</span>
                                    </div>
                                </div>
                                <div className="bg-[#0b0b0d] flex flex-col items-center justify-center pt-4">
                                    <Fader value={track.fx.eqHigh} min={-12} max={12} label="HIGH" unit="dB" color="cyan" height={160} onChange={(v) => updateFX('eqHigh', v)} />
                                    <div className="mt-2 border-t border-white/5 w-full flex justify-center py-2">
                                       <Knob value={track.fx.presence || 4000} min={1000} max={10000} logarithmic label="AIR" unit="Hz" color="cyan" size={32} onChange={(v) => updateFX('presence', v)} />
                                    </div>
                                </div>
                            </div>
                       </div>
                   )}

                   {/* 3. MODULATION (EXPANDED) */}
                   {activeTab === 'MODULATION' && (
                       <div className="grid grid-cols-1 gap-px bg-white/5 pb-20">
                           {/* CHORUS */}
                           <div className="bg-[#0e0e11] p-3 flex items-center justify-between border-b border-white/5 relative overflow-hidden">
                               <LFOOscilloscope rate={track.fx.chorusRate || 1.5} depth={track.fx.chorusDepth || 0.5} color="#a855f7" />
                               <div className="relative z-10 w-full flex justify-between items-center px-2">
                                    <span className="text-[9px] font-black text-purple-500 -rotate-90 w-4">CHORUS</span>
                                    <Knob value={track.fx.chorusMix || 0} min={0} max={1} label="MIX" unit="%" color="purple" size={36} onChange={(v) => updateFX('chorusMix', v)} />
                                    <Knob value={track.fx.chorusRate || 1.5} min={0.1} max={5} label="RATE" unit="Hz" color="purple" size={36} onChange={(v) => updateFX('chorusRate', v)} />
                                    <Knob value={(track.fx.chorusDepth || 0.002) * 1000} min={0} max={10} label="DEPTH" unit="ms" color="purple" size={36} onChange={(v) => updateFX('chorusDepth', v/1000)} />
                               </div>
                           </div>
                           
                           {/* FLANGER */}
                           <div className="bg-[#0e0e11] p-3 flex items-center justify-between border-b border-white/5 relative overflow-hidden">
                                <LFOOscilloscope rate={track.fx.flangerRate || 0.5} depth={0.8} color="#3b82f6" />
                                <div className="relative z-10 w-full flex justify-between items-center px-2">
                                    <span className="text-[9px] font-black text-blue-500 -rotate-90 w-4">FLANGE</span>
                                    <Knob value={track.fx.flangerMix || 0} min={0} max={1} label="MIX" unit="%" color="blue" size={36} onChange={(v) => updateFX('flangerMix', v)} />
                                    <Knob value={track.fx.flangerRate || 0.5} min={0.1} max={2} label="RATE" unit="Hz" color="blue" size={36} onChange={(v) => updateFX('flangerRate', v)} />
                                    <Knob value={track.fx.flangerFeedback || 0} min={0} max={0.95} label="FDBK" unit="%" color="blue" size={36} onChange={(v) => updateFX('flangerFeedback', v)} />
                               </div>
                           </div>

                           {/* PHASER */}
                           <div className="bg-[#0e0e11] p-3 flex items-center justify-between relative overflow-hidden">
                                <LFOOscilloscope rate={track.fx.phaserRate || 1.0} depth={0.6} color="#ec4899" />
                                <div className="relative z-10 w-full flex justify-between items-center px-2">
                                    <span className="text-[9px] font-black text-pink-500 -rotate-90 w-4">PHASE</span>
                                    <Knob value={track.fx.phaserMix || 0} min={0} max={1} label="MIX" unit="%" color="pink" size={36} onChange={(v) => updateFX('phaserMix', v)} />
                                    <Knob value={track.fx.phaserRate || 1.0} min={0.1} max={5} label="RATE" unit="Hz" color="pink" size={36} onChange={(v) => updateFX('phaserRate', v)} />
                                    <div className="w-9"></div> {/* Spacer */}
                               </div>
                           </div>
                       </div>
                   )}

                   {/* 4. SPACE & COLOR */}
                   {activeTab === 'SPACE' && (
                       <div className="grid grid-cols-2 gap-px bg-white/5 h-full">
                           {/* SATURATION */}
                           <div className="col-span-2 bg-[#0e0e11] h-32 relative overflow-hidden border-b border-white/5">
                                <XYPad 
                                 x={(track.fx.saturation || 0) / 100} 
                                 y={(Math.min(20000, Math.max(1000, track.fx.distortionTone || 20000)) - 1000) / 19000}
                                 labelX="TUBE DRIVE" labelY="TONE" color="orange"
                                 onChange={(x, y) => {
                                     updateFX('saturation', x * 100);
                                     updateFX('distortionTone', 1000 + (y * 19000));
                                 }}
                               />
                           </div>

                           {/* AUTO WAH & CABINET SPLIT */}
                           <div className="col-span-2 grid grid-cols-2 border-b border-white/5">
                               {/* AUTO WAH */}
                               <div className="bg-[#0e0e11] p-2 flex flex-col items-center justify-center border-r border-white/5">
                                   <div className="flex items-center space-x-2 mb-2">
                                        <span className="text-[8px] font-black text-green-400">AUTO-WAH</span>
                                        <div className={`w-1.5 h-1.5 rounded-full ${track.fx.autoWahMix > 0 ? 'bg-green-500 shadow-[0_0_5px_lime]' : 'bg-slate-800'}`}></div>
                                   </div>
                                   <div className="flex space-x-2">
                                        <Knob value={track.fx.autoWahSens || 0} min={0} max={100} label="SENS" unit="%" color="green" size={32} onChange={(v) => updateFX('autoWahSens', v)} />
                                        <Knob value={track.fx.autoWahMix || 0} min={0} max={1} label="MIX" unit="%" color="green" size={32} onChange={(v) => updateFX('autoWahMix', v)} />
                                   </div>
                               </div>

                               {/* CABINET EMULATOR */}
                               <div className="bg-[#0e0e11] p-2 flex flex-col items-center justify-center relative overflow-hidden">
                                   <div className="flex items-center space-x-2 mb-2 z-10">
                                        <Toggle 
                                            value={track.fx.cabinetOn} 
                                            onChange={(v) => updateFX('cabinetOn', v)} 
                                            label="CABINET" 
                                            color="orange"
                                            size="sm" 
                                        />
                                   </div>
                                   {track.fx.cabinetOn && (
                                       <div className="absolute inset-0 pointer-events-none opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-orange-500 via-transparent to-transparent"></div>
                                   )}
                                   <Knob value={track.fx.cabinetTone} min={0} max={1} label="TONE" unit="%" color="orange" size={36} onChange={(v) => updateFX('cabinetTone', v)} />
                               </div>
                           </div>

                           {/* BITCRUSH */}
                           <div className="bg-[#0e0e11] flex flex-col items-center justify-center p-2 border-r border-white/5">
                                <span className="text-[8px] text-red-500 font-bold mb-1">BITCRUSH</span>
                                <Knob value={track.fx.bitCrushMix || 0} min={0} max={1} label="MIX" unit="%" color="red" size={36} onChange={(v) => updateFX('bitCrushMix', v)} />
                                <div className="h-2"></div>
                                <Fader value={track.fx.bitCrushBits || 16} min={1} max={16} label="BITS" unit="b" color="red" height={60} onChange={(v) => updateFX('bitCrushBits', Math.round(v))} />
                           </div>

                           {/* SENDS */}
                           <div className="bg-[#0e0e11] flex flex-col items-center justify-around p-2">
                                <span className="text-[8px] text-blue-500 font-bold">SENDS</span>
                                <Knob value={track.fx.sendReverb} min={0} max={1} label="VERB" unit="%" color="blue" size={36} onChange={(v) => updateFX('sendReverb', v)} />
                                <Knob value={track.fx.sendDelay} min={0} max={1} label="DELAY" unit="%" color="blue" size={36} onChange={(v) => updateFX('sendDelay', v)} />
                           </div>
                       </div>
                   )}

               </div>
           </div>
       )}
    </div>
  );
});
</file>

<file path="components/ClipInspector.tsx">
import React from 'react';
import { AudioClip } from '../types';
import { Knob } from './Knob';
import { Toggle } from './Toggle';
import { EnvelopeGraph, FilterResponse, LFOOscilloscope } from './Visualizers';

interface ClipInspectorProps {
  clip: AudioClip;
  onUpdate: (clipId: string, updates: Partial<AudioClip['fx']> | { viewConfig: any }) => void;
  onClose: () => void;
}

const InspectorModule: React.FC<{ title: string; children: React.ReactNode; visualizer?: React.ReactNode }> = ({ title, children, visualizer }) => (
    <div className="flex flex-col h-full bg-[#0b1120] border-r border-slate-800 relative group min-w-[140px] overflow-hidden">
         {visualizer}
         {/* Industrial Header */}
         <div className="h-7 bg-black/80 border-b border-slate-800 flex items-center justify-center relative z-10 backdrop-blur-sm">
             <div className="text-[8px] font-black tracking-widest uppercase text-slate-500">{title}</div>
         </div>
         {/* Controls */}
         <div className="flex-1 flex items-center justify-center space-x-3 px-2 relative z-10">
            {children}
         </div>
         {/* Screws */}
         <div className="absolute top-1 right-1 w-0.5 h-0.5 rounded-full bg-slate-700 z-20"></div>
         <div className="absolute top-1 left-1 w-0.5 h-0.5 rounded-full bg-slate-700 z-20"></div>
    </div>
);

export const ClipInspector: React.FC<ClipInspectorProps> = ({ clip, onUpdate, onClose }) => {
  const updateFX = (key: keyof AudioClip['fx'], value: any) => {
    onUpdate(clip.id, { [key]: value });
  };

  const updateView = (key: keyof AudioClip['viewConfig'], value: any) => {
      const currentConfig = clip.viewConfig || { mode: 'PCM', resolution: 2, scale: 1.0 };
      onUpdate(clip.id, { 
          viewConfig: { ...currentConfig, [key]: value } 
      });
  };
  
  const viewScale = clip.viewConfig?.scale || 1;
  const isCandle = clip.viewConfig?.mode === 'CANDLESTICK';

  return (
    <div className="fixed bottom-0 left-0 right-0 h-[200px] bg-[#020617] border-t-2 border-slate-700 shadow-[0_-10px_50px_rgba(0,0,0,0.9)] z-[60] flex flex-col animate-in slide-in-from-bottom duration-300">
      
      {/* Main Header */}
      <div className="h-8 bg-black flex items-center justify-between px-3 border-b border-slate-800 relative">
         <div className="absolute inset-0 opacity-20 pointer-events-none" 
              style={{ backgroundImage: 'repeating-linear-gradient(45deg, transparent, transparent 5px, rgba(255,255,255,0.05) 5px, rgba(255,255,255,0.05) 10px)' }}></div>
         
         <div className="flex items-center space-x-3 z-10">
            <div className="w-1.5 h-1.5 rounded-full bg-yellow-500 animate-pulse shadow-[0_0_8px_rgba(234,179,8,0.8)]"></div>
            <span className="text-[10px] font-black text-yellow-500 tracking-widest uppercase">CLIP EDITOR</span>
            <span className="text-[10px] text-slate-600">|</span>
            <span className="text-[10px] text-white font-mono uppercase truncate max-w-[200px]">{clip.name}</span>
         </div>
         
         <button onClick={onClose} className="text-slate-500 hover:text-white px-3 font-bold z-10 uppercase text-[9px] tracking-widest border border-transparent hover:border-slate-700 rounded transition-all">
            EXIT
         </button>
      </div>

      {/* Rack Container */}
      <div className="flex-1 overflow-x-auto overflow-y-hidden scrollbar-hide bg-[#050a15] relative">
          {/* Background Grid */}
          <div className="absolute inset-0 opacity-5 pointer-events-none" 
               style={{ backgroundImage: 'linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px)', backgroundSize: '20px 20px' }}></div>
          
          <div className="flex h-full min-w-max">
            
            {/* 1. VISUALS */}
            <InspectorModule title="VISUALIZATION">
                <Knob value={viewScale} min={0.5} max={3.0} label="ZOOM" unit="x" color="white" size={40} onChange={(v) => updateView('scale', v)} />
                <div className="flex flex-col items-center justify-center space-y-2 ml-2">
                    <Toggle 
                        value={isCandle} 
                        onChange={() => updateView('mode', isCandle ? 'PCM' : 'CANDLESTICK')} 
                        label={isCandle ? 'CNDL' : 'PCM'} 
                        color="cyan"
                        vertical
                    />
                    <span className="text-[7px] text-slate-600 font-bold uppercase">TYPE</span>
                </div>
            </InspectorModule>

            {/* 2. SOURCE */}
            <InspectorModule title="SOURCE">
                <Knob value={clip.fx.gain} min={0} max={2} label="GAIN" unit="" color="green" size={40} onChange={(v) => updateFX('gain', v)} />
                <Knob value={clip.fx.pan} min={-1} max={1} label="PAN" unit="" color="yellow" size={40} resetValue={0} bipolar onChange={(v) => updateFX('pan', v)} />
            </InspectorModule>

            {/* 3. TIME */}
            <InspectorModule title="TIME / PITCH">
                <Knob value={clip.fx.pitch} min={0.25} max={2.0} label="RATE" unit="x" color="cyan" size={40} resetValue={1} onChange={(v) => updateFX('pitch', v)} />
                <div className="flex flex-col items-center justify-center space-y-2 ml-1">
                    <Toggle 
                        value={clip.fx.isReversed} 
                        onChange={(v) => updateFX('isReversed', v)} 
                        label="REV" 
                        color="pink"
                    />
                    <span className="text-[7px] text-slate-600 font-bold uppercase">DIR</span>
                </div>
            </InspectorModule>

            {/* 4. ENVELOPE */}
            <InspectorModule title="FADES" visualizer={<EnvelopeGraph fadeIn={clip.fx.fadeIn || 0} fadeOut={clip.fx.fadeOut || 0} color="#22c55e" />}>
                <Knob value={clip.fx.fadeIn || 0.01} min={0.01} max={2.0} label="IN" unit="s" color="green" size={32} onChange={(v) => updateFX('fadeIn', v)} />
                <Knob value={clip.fx.fadeOut || 0.01} min={0.01} max={2.0} label="OUT" unit="s" color="green" size={32} onChange={(v) => updateFX('fadeOut', v)} />
            </InspectorModule>

            {/* 5. FILTER */}
            <InspectorModule title="FILTER" visualizer={<FilterResponse freq={clip.fx.filterFreq || 20000} res={clip.fx.filterRes || 0} type="lowpass" color="#ec4899" />}>
                <Knob value={clip.fx.filterFreq || 20000} min={100} max={20000} logarithmic label="FREQ" unit="Hz" color="pink" size={36} onChange={(v) => updateFX('filterFreq', v)} />
                <Knob value={clip.fx.filterRes || 0} min={0} max={20} label="RES" unit="" color="pink" size={36} onChange={(v) => updateFX('filterRes', v)} />
            </InspectorModule>

            {/* 6. FX: MODULATION */}
            <InspectorModule title="LFO MOD" visualizer={<LFOOscilloscope rate={clip.fx.tremoloRate || 4} depth={clip.fx.tremoloDepth || 0} color="#a855f7" />}>
                 <Knob value={clip.fx.saturation || 0} min={0} max={100} label="DRIVE" unit="%" color="orange" size={32} onChange={(v) => updateFX('saturation', v)} />
                 <div className="w-px h-10 bg-slate-800 mx-1"></div>
                 <Knob value={clip.fx.tremoloDepth || 0} min={0} max={1} label="TREM" unit="%" color="purple" size={32} onChange={(v) => updateFX('tremoloDepth', v)} />
                 <Knob value={clip.fx.tremoloRate || 4} min={0.5} max={20} label="RATE" unit="Hz" color="purple" size={32} onChange={(v) => updateFX('tremoloRate', v)} />
            </InspectorModule>

            {/* 7. FX: DELAY (NEW) */}
            <InspectorModule title="CLIP DELAY">
                 <Knob value={clip.fx.delayMix || 0} min={0} max={1} label="MIX" unit="%" color="blue" size={32} onChange={(v) => updateFX('delayMix', v)} />
                 <Knob value={clip.fx.delayTime || 0.3} min={0.05} max={1.0} label="TIME" unit="s" color="blue" size={32} onChange={(v) => updateFX('delayTime', v)} />
                 <Knob value={clip.fx.delayFeedback || 0.4} min={0} max={0.9} label="FDBK" unit="%" color="blue" size={32} onChange={(v) => updateFX('delayFeedback', v)} />
            </InspectorModule>

          </div>
      </div>
    </div>
  );
};
</file>

<file path="components/Controls.tsx">
import React from 'react';
import { EditMode, ViewSettings } from '../types';

interface ControlsProps {
  isPlaying: boolean;
  isRecording: boolean;
  isLooping: boolean;
  loopRange: { start: number; end: number } | null;
  onPlayPause: () => void;
  onRecord: () => void;
  onStop: () => void;
  onBounce: () => void;
  onDelete: () => void;
  onSplit: () => void;
  onCopy: () => void;
  onPaste: () => void;
  onToggleLoop: () => void;
  onSetLoopIn: () => void;
  onSetLoopOut: () => void;
  onOpenInfo: () => void;
  onShowCredits: () => void;
  onToggleLogs: () => void; // New Prop
  editMode: EditMode;
  setEditMode: (mode: EditMode) => void;
  monitor: boolean;
  setMonitor: (val: boolean) => void;
  zoom: number;
  setZoom: (val: number) => void;
  hasSelection: boolean;
  hasClipboard: boolean;
  viewSettings: ViewSettings;
  setViewSettings: (val: ViewSettings) => void;
}

export const Controls: React.FC<ControlsProps> = React.memo(({
  isPlaying, isRecording, isLooping, loopRange,
  onPlayPause, onRecord, onStop, onBounce, onDelete, onSplit, onCopy, onPaste,
  onToggleLoop, onSetLoopIn, onSetLoopOut, onOpenInfo, onShowCredits, onToggleLogs,
  editMode, setEditMode, monitor, setMonitor, zoom, setZoom, hasSelection, hasClipboard,
  viewSettings, setViewSettings
}) => {

  const toggleView = (key: keyof ViewSettings) => {
      setViewSettings({ ...viewSettings, [key]: !viewSettings[key] });
  };

  return (
    <div className="fixed top-0 left-0 right-0 h-[60px] bg-black/80 backdrop-blur-md border-b border-white/10 flex items-center justify-between px-2 md:px-4 z-50 shadow-2xl overflow-x-auto overflow-y-hidden scrollbar-hide">
      
      {/* Group 1: Transport */}
      <div className="flex items-center space-x-2 mr-4 flex-shrink-0">
        <div className="flex items-center space-x-1 bg-slate-900/50 p-1 rounded-full border border-slate-800">
            <button
            className={`w-9 h-9 rounded-full flex items-center justify-center transition-all shadow-inner ${isRecording ? 'bg-red-600 animate-pulse shadow-red-500/50' : 'bg-slate-800 hover:bg-slate-700'}`}
            onClick={onRecord}
            title="Record"
            >
            <div className={`w-2.5 h-2.5 rounded-full ${isRecording ? 'bg-white' : 'bg-red-500'}`}></div>
            </button>
            <button
            className="w-9 h-9 rounded-full bg-slate-200 hover:bg-white flex items-center justify-center active:scale-95 transition-transform shadow-lg shadow-white/10"
            onClick={onPlayPause}
            title="Play/Pause"
            >
            {isPlaying ? (
                <div className="w-2.5 h-2.5 flex space-x-0.5 justify-center">
                <div className="w-1 h-full bg-slate-900 rounded-[1px]"></div>
                <div className="w-1 h-full bg-slate-900 rounded-[1px]"></div>
                </div>
            ) : (
                <div className="w-0 h-0 border-t-[5px] border-t-transparent border-l-[8px] border-l-slate-900 border-b-[5px] border-b-transparent ml-0.5"></div>
            )}
            </button>
            <button
            className="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-[8px] font-bold text-slate-400 hover:text-white active:scale-95 transition-transform border border-slate-700"
            onClick={onStop}
            title="Stop / Return Zero"
            >
            <div className="w-2.5 h-2.5 bg-slate-400 rounded-[1px]"></div>
            </button>
        </div>
      </div>

      {/* Group 2: VIEW MATRIX (New) */}
      <div className="flex items-center space-x-1 mr-4 border-l border-white/10 pl-4 flex-shrink-0">
         <div className="flex flex-col space-y-0.5">
             <span className="text-[7px] font-bold text-slate-600 tracking-widest uppercase mb-0.5">View Matrix</span>
             <div className="flex space-x-1">
                 <button 
                    onClick={() => toggleView('isCollapsed')}
                    className={`h-5 px-1.5 rounded border text-[8px] font-bold transition-all ${!viewSettings.isCollapsed ? 'bg-cyan-900/40 border-cyan-700 text-cyan-400' : 'bg-transparent border-slate-700 text-slate-600'}`}
                 >MAIN</button>
                 <button 
                    onClick={() => toggleView('showTransport')}
                    className={`h-5 px-1.5 rounded border text-[8px] font-bold transition-all ${viewSettings.showTransport ? 'bg-cyan-900/40 border-cyan-700 text-cyan-400' : 'bg-transparent border-slate-700 text-slate-600'}`}
                 >TRNS</button>
                 <button 
                    onClick={() => toggleView('showMix')}
                    className={`h-5 px-1.5 rounded border text-[8px] font-bold transition-all ${viewSettings.showMix ? 'bg-cyan-900/40 border-cyan-700 text-cyan-400' : 'bg-transparent border-slate-700 text-slate-600'}`}
                 >MIX</button>
             </div>
         </div>
      </div>

      {/* Group 3: Edit Tools */}
      <div className="flex items-center space-x-2 flex-shrink-0">
         <div className="flex bg-black/50 rounded-lg p-0.5 border border-white/10">
             <button 
               className={`w-16 py-1.5 rounded-md text-[9px] font-bold transition-all flex items-center justify-center space-x-1 ${editMode === EditMode.MOVE ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-400 hover:text-white'}`}
               onClick={() => setEditMode(EditMode.MOVE)}
             >
               <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M5 9l-3 3 3 3M9 5l3-3 3 3M19 9l3 3-3 3M9 19l3 3 3 3M2 12h20M12 2v20"/></svg>
               <span>MOVE</span>
             </button>
             <button 
               className={`w-16 py-1.5 rounded-md text-[9px] font-bold transition-all flex items-center justify-center space-x-1 ${editMode === EditMode.SPLIT ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-400 hover:text-white'}`}
               onClick={() => setEditMode(EditMode.SPLIT)}
             >
               <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
               <span>TAP</span>
             </button>
         </div>

         <div className="flex flex-col space-y-1">
             <div className="flex space-x-1">
                 <button 
                    disabled={!hasSelection}
                    onClick={onCopy}
                    className={`h-6 px-2 flex items-center justify-center rounded border transition-all text-[8px] font-bold ${hasSelection ? 'bg-slate-800 text-white border-slate-600 hover:bg-slate-700' : 'bg-transparent text-slate-700 border-transparent cursor-not-allowed'}`}
                    title="Copy Clip"
                 >COPY</button>
                 <button 
                    disabled={!hasClipboard}
                    onClick={onPaste}
                    className={`h-6 px-2 flex items-center justify-center rounded border transition-all text-[8px] font-bold ${hasClipboard ? 'bg-slate-800 text-white border-slate-600 hover:bg-slate-700' : 'bg-transparent text-slate-700 border-transparent cursor-not-allowed'}`}
                    title="Paste Clip"
                 >PASTE</button>
             </div>
             <button 
                disabled={!hasSelection}
                onClick={onSplit}
                className={`h-6 px-2 flex items-center justify-center rounded border transition-all text-[8px] font-bold
                    ${hasSelection 
                        ? 'border-slate-600 bg-slate-800 text-white hover:bg-slate-700 shadow-sm' 
                        : 'border-transparent text-slate-700 cursor-not-allowed'}`}
                title="Split at Playhead"
             >
                 SPLIT
             </button>
         </div>
         
         <button 
            disabled={!hasSelection}
            onClick={onDelete}
            className={`w-8 h-12 flex items-center justify-center rounded border transition-all ml-1
                ${hasSelection 
                    ? 'border-red-900 bg-red-900/20 text-red-500 hover:bg-red-900 hover:text-white cursor-pointer' 
                    : 'border-transparent text-slate-800 cursor-not-allowed'}`}
            title="Delete Selected"
         >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
         </button>
      </div>

      {/* Group 4: Config & Utils */}
      <div className="flex items-center space-x-2 flex-shrink-0 ml-auto pl-4 border-l border-white/10">
        
        <button
            onClick={onShowCredits}
            className="text-[10px] font-bold text-slate-500 hover:text-white uppercase tracking-widest mr-2"
        >
            Credits
        </button>

        {/* LOGS TOGGLE */}
        <button
            onClick={onToggleLogs}
            className="h-8 px-2 rounded border border-slate-700 bg-black/40 text-[9px] font-bold text-slate-400 hover:text-cyan-400 hover:border-cyan-700 uppercase tracking-widest transition-colors flex items-center gap-1"
        >
            <span className="w-1.5 h-1.5 rounded-full bg-slate-600"></span>
            LOGS
        </button>

        <button
            onClick={onOpenInfo}
            className="w-8 h-8 rounded-full bg-black border border-blue-900/50 text-blue-500 hover:text-white hover:bg-blue-900 flex items-center justify-center transition-colors"
            title="Project Info & Export"
        >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        </button>

        <div className="flex flex-col items-center group">
            <div className="flex -space-x-px">
                <button 
                    className="h-6 px-1.5 bg-black border border-slate-700 rounded-l text-[10px] text-slate-400 hover:bg-slate-800 font-mono"
                    onClick={() => setZoom(Math.max(10, zoom * 0.8))}
                >-</button>
                <button 
                    className="h-6 px-1.5 bg-black border border-slate-700 rounded-r text-[10px] text-slate-400 hover:bg-slate-800 font-mono"
                    onClick={() => setZoom(Math.min(500, zoom * 1.25))}
                >+</button>
            </div>
        </div>

        <button
          className={`w-8 h-6 rounded border text-[9px] font-bold tracking-wider transition-colors flex items-center justify-center ${monitor ? 'bg-green-500/20 border-green-500 text-green-400' : 'bg-black border-slate-700 text-slate-500 hover:text-slate-300'}`}
          onClick={() => setMonitor(!monitor)}
          title="Input Monitor"
        >
          MON
        </button>
